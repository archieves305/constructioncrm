{
  "expo": {
    "name": "KNU Field",
    "slug": "knu-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.knuconstruction.field"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.knuconstruction.field"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "KNU Field attaches the photos you choose to the job or task you pick.",
          "cameraPermission": "KNU Field uses the camera to take job and task photos for the CRM.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "knuco",
    "experiments": {
      "typedRoutes": true
    }
  }
}
