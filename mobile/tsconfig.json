{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@crm/mobile-api": [
        "../src/lib/mobile-api/index.ts"
      ],
      "zod": [
        "./node_modules/zod"
      ],
      "zod/*": [
        "./node_modules/zod/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
