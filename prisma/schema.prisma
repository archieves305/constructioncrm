// ─── Roof Estimates ─────────────────────────────────────────────────────────

enum RoofMaterial {
  SHINGLE
  TILE
  METAL
  FLAT
}

// Singleton (id="default") with company branding + per-proposal defaults
// for the customer-facing roofing proposal PDF. Editable from /admin/roofing-brand.
model RoofingBrand {
  id                              String   @id @default("default")
  companyName                     String   @map("company_name")
  addressLine1                    String?  @map("address_line_1")
  addressLine2                    String?  @map("address_line_2")
  city                            String?
  state                           String?
  zip                             String?
  phone                           String?
  email                           String?
  website                         String?
  roofingLicense                  String?  @map("roofing_license")
  gcLicense                       String?  @map("gc_license")
  logoStorageKey                  String?  @map("logo_storage_key")
  defaultExpirationDays           Int      @default(30) @map("default_expiration_days")
  defaultUnderlaymentType         String?  @map("default_underlayment_type")
  defaultPlywoodSheetsIncluded    Int      @default(3) @map("default_plywood_sheets_included")
  defaultAdditionalPlywoodPrice   Decimal  @default(85) @map("default_additional_plywood_price") @db.Decimal(12, 2)
  defaultWorkmanshipWarrantyYears Int      @default(10) @map("default_workmanship_warranty_years")
  defaultManufacturerWarranty     String?  @map("default_manufacturer_warranty")
  paymentDepositPercent           Decimal  @default(40) @map("payment_deposit_percent") @db.Decimal(5, 2)
  paymentProgressPercent          Decimal  @default(40) @map("payment_progress_percent") @db.Decimal(5, 2)
  paymentFinalPercent             Decimal  @default(20) @map("payment_final_percent") @db.Decimal(5, 2)
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("roofing_brand")
}

model RoofEstimate {
  id                       String   @id @default(cuid())
  leadId                   String   @map("lead_id")
  estimateNumber           String   @unique @map("estimate_number")
  // roofTypesJson: array of { material: RoofMaterial, squares: number, laborRatePerSquare: number }
  roofTypesJson            Json     @map("roof_types_json")
  materialCost             Decimal  @default(0) @map("material_cost") @db.Decimal(12, 2)
  materialSelection        String?  @map("material_selection") @db.Text
  // Customer-facing proposal fields (defaults pulled from RoofingBrand on form load)
  existingRoofType         String?  @map("existing_roof_type")
  proposedRoofTypeOverride String?  @map("proposed_roof_type_override")
  underlaymentType         String?  @map("underlayment_type")
  permitIncluded           Boolean  @default(true) @map("permit_included")
  projectDurationText      String?  @map("project_duration_text")
  plywoodSheetsIncluded    Int?     @map("plywood_sheets_included")
  additionalPlywoodPrice   Decimal? @map("additional_plywood_price") @db.Decimal(12, 2)
  workmanshipWarrantyYears Int?     @map("workmanship_warranty_years")
  manufacturerWarranty     String?  @map("manufacturer_warranty")
  isEstimateOnly           Boolean  @default(false) @map("is_estimate_only")
  permitFee                Decimal  @default(0) @map("permit_fee") @db.Decimal(12, 2)
  dumpsterFee              Decimal  @default(0) @map("dumpster_fee") @db.Decimal(12, 2)
  tearOffFee               Decimal  @default(0) @map("tear_off_fee") @db.Decimal(12, 2)
  deckingFee               Decimal  @default(0) @map("decking_fee") @db.Decimal(12, 2)
  underlaymentFee          Decimal  @default(0) @map("underlayment_fee") @db.Decimal(12, 2)
  flashingVentFee          Decimal  @default(0) @map("flashing_vent_fee") @db.Decimal(12, 2)
  skylightChimneyFee       Decimal  @default(0) @map("skylight_chimney_fee") @db.Decimal(12, 2)
  guttersFee               Decimal  @default(0) @map("gutters_fee") @db.Decimal(12, 2)
  miscLabel                String?  @map("misc_label")
  miscFee                  Decimal  @default(0) @map("misc_fee") @db.Decimal(12, 2)
  marginPercent            Decimal  @default(0) @map("margin_percent") @db.Decimal(6, 3)
  discountEnabled          Boolean  @default(false) @map("discount_enabled")
  discountPercent          Decimal  @default(0) @map("discount_percent") @db.Decimal(6, 3)
  salesTaxPercent          Decimal  @default(0) @map("sales_tax_percent") @db.Decimal(6, 3)
  validityDays             Int      @default(30) @map("validity_days")
  specialTerms             String?  @map("special_terms") @db.Text
  subtotalCost             Decimal  @map("subtotal_cost") @db.Decimal(12, 2)
  totalPrice               Decimal  @map("total_price") @db.Decimal(12, 2)
  createdByUserId          String   @map("created_by_user_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation("RoofEstimateCreatedBy", fields: [createdByUserId], references: [id])

  @@index([leadId])
  @@map("roof_estimates")
}

enum RoofrOrderStatus {
  REQUESTED
  COMPLETED
  CANCELLED
  FAILED
}

model RoofrOrder {
  id              String           @id @default(cuid())
  leadId          String           @map("lead_id")
  status          RoofrOrderStatus @default(REQUESTED)
  externalOrderId String?          @map("external_order_id")
  reportUrl       String?          @map("report_url")
  notes           String?          @db.Text
  errorMessage    String?          @map("error_message") @db.Text
  requestedAt     DateTime         @default(now()) @map("requested_at")
  completedAt     DateTime?        @map("completed_at")
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation("RoofrOrderCreatedBy", fields: [createdByUserId], references: [id])

  @@index([leadId])
  @@map("roofr_orders")
}

// ─── Zylow property cache ─────────────────────────────────────────────────────
// Local mirror of zylow.net's read-only property API (canonical shape). We serve
// from here and refresh from Zylow on a ~24h TTL — never call Zylow from the
// browser (the API key stays server-side). Keyed by REAPI's property id.
model ZylowProperty {
  reapiId              String    @id @map("reapi_id")
  address              String?
  city                 String?
  state                String?
  zip                  String?
  county               String?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  ownerName            String?   @map("owner_name")
  bedrooms             Int?
  bathrooms            Decimal?  @db.Decimal(4, 1)
  sqft                 Int?
  yearBuilt            Int?      @map("year_built")
  propertyType         String?   @map("property_type")
  roofType             String?   @map("roof_type")
  lastSaleDate         DateTime? @map("last_sale_date") @db.Date
  lastSaleAmount       Int?      @map("last_sale_amount")
  outstandingMortgages Int?      @map("outstanding_mortgages")
  estimatedValue       Int?      @map("estimated_value")
  cachedAtZylow        DateTime? @map("cached_at_zylow")
  fetchedAtLocal       DateTime  @default(now()) @updatedAt @map("fetched_at_local")

  @@index([state, city])
  @@index([latitude, longitude])
  @@map("zylow_property_cache")
}

// ─── Canvassing prospects ─────────────────────────────────────────────────────
// A prospect is the unit of door-to-door canvassing: a property (usually sourced
// from the Zylow API by GPS/address) that we knock and track BEFORE it becomes a
// CRM lead. Door-knock routes and knocks reference prospects; when a prospect is
// worth pursuing it's "promoted" into a Lead (leadId set, status PROMOTED).
enum ProspectStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  PROMOTED
  DEAD
}

model Prospect {
  id               String         @id @default(cuid())
  reapiId          String?        @map("reapi_id") // Zylow/REAPI property id, if sourced from there
  ownerName        String?        @map("owner_name")
  propertyAddress1 String         @map("property_address_1")
  propertyAddress2 String?        @map("property_address_2")
  city             String
  state            String         @default("FL")
  zipCode          String?        @map("zip_code")
  county           String?
  latitude         Decimal?       @db.Decimal(10, 7)
  longitude        Decimal?       @db.Decimal(10, 7)
  status           ProspectStatus @default(NEW)
  notes            String?        @db.Text
  assignedToUserId String?        @map("assigned_to_user_id")
  createdByUserId  String         @map("created_by_user_id")
  leadId           String?        @unique @map("lead_id") // set on promotion
  promotedAt       DateTime?      @map("promoted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  assignedTo User? @relation("ProspectAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy  User  @relation("ProspectCreatedBy", fields: [createdByUserId], references: [id])
  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  knocks PropertyDoorKnock[]
  stops  DoorKnockRouteStop[]
  tasks  Task[]

  @@index([status])
  @@index([assignedToUserId])
  @@index([latitude, longitude])
  @@index([reapiId])
  @@map("prospects")
}

// ─── Canvassing lead scoring ──────────────────────────────────────────────────
// Enriched, scored property record powering the Find Properties "Knock Score" and
// the Canvasser One-Screen Summary. Sourced from the Zylow/REAPI data (keyed by
// reapiId, the same id Prospect.reapiId carries). The full upstream payload is
// kept in realapi_raw_json for re-scoring/reference; the most-used fields are
// normalized into columns for fast list/sort/display. last_realapi_sync_at drives
// the 30-day refresh rule (see CanvassingSettings.cacheTtlDays).
model CanvassingProperty {
  id                       String    @id @default(cuid())
  reapiId                  String    @unique @map("reapi_id")
  propertyAddress          String?   @map("property_address")
  city                     String?
  state                    String?
  zip                      String?
  ownerName                String?   @map("owner_name")
  mailingAddress           String?   @map("mailing_address")
  ownerOccupied            Boolean?  @map("owner_occupied")
  yearBuilt                Int?      @map("year_built")
  ownedSince               Int?      @map("owned_since")
  lastSaleDate             DateTime? @map("last_sale_date") @db.Date
  lastSalePrice            Int?      @map("last_sale_price")
  estimatedValue           Int?      @map("estimated_value")
  estimatedMortgageBalance Int?      @map("estimated_mortgage_balance")
  estimatedEquity          Int?      @map("estimated_equity")
  equityPercentage         Int?      @map("equity_percentage")
  lastRoofPermitDate       DateTime? @map("last_roof_permit_date") @db.Date
  estimatedRoofAge         Int?      @map("estimated_roof_age")
  roofType                 String?   @map("roof_type")
  propertyType             String?   @map("property_type")
  buildingSqft             Int?      @map("building_sqft")
  stories                  Int?
  lotSizeSqft              Int?      @map("lot_size_sqft")
  knockScore               Int       @default(0) @map("knock_score")
  knockScoreTier           String?   @map("knock_score_tier")
  recommendedOpening       String?   @map("recommended_opening") @db.Text
  canvasserSummaryJson     Json?     @map("canvasser_summary_json")
  realapiRawJson           Json?     @map("realapi_raw_json")
  lastRealapiSyncAt        DateTime? @map("last_realapi_sync_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([knockScore])
  @@index([state, city])
  @@map("canvassing_properties")
}

// Singleton (id = "default") admin configuration for canvassing lead scoring:
// the full per-rule Knock Score config (JSON), display/visibility toggles, the
// default opening script, and the compliance disclaimer. Mirrors the EmailBrand
// singleton pattern.
model CanvassingSettings {
  id                     String   @id @default("default")
  scoringConfigJson      Json     @map("scoring_config_json")
  minPriorityScore       Int      @default(50) @map("min_priority_score")
  showAbsenteeOwners     Boolean  @default(true) @map("show_absentee_owners")
  hideLowScoreProperties Boolean  @default(false) @map("hide_low_score_properties")
  cacheTtlDays           Int      @default(30) @map("cache_ttl_days")
  defaultOpeningScript   String   @map("default_opening_script") @db.Text
  complianceDisclaimer   String   @map("compliance_disclaimer") @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("canvassing_settings")
}

// ─── Generic Estimate Engine (template-driven, non-roofing) ──────────────────
// Roofing keeps its specialized RoofEstimate model above. These tables power
// the template-driven estimate builder for Drywall, Interior Renovation, and
// Windows & Doors (and any future trade), with sectioned line items + units.

enum EstimateTemplateCategory {
  ROOFING
  DRYWALL
  INTERIOR_RENOVATION
  WINDOWS_DOORS
}

enum EstimateUnitType {
  EACH
  OPENING
  SHEET
  SQ_FT
  LINEAR_FT
  ROOM
  LUMP_SUM
  LABOR_HOUR
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model EstimateTemplate {
  id        String                   @id @default(cuid())
  key       String                   @unique
  category  EstimateTemplateCategory
  name      String
  isActive  Boolean                  @default(true) @map("is_active")
  sortOrder Int                      @default(0) @map("sort_order")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  sections  EstimateTemplateSection[]
  estimates Estimate[]

  @@map("estimate_templates")
}

model EstimateTemplateSection {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  title      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template EstimateTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    EstimateTemplateLineItem[]

  @@index([templateId])
  @@map("estimate_template_sections")
}

model EstimateTemplateLineItem {
  id               String           @id @default(cuid())
  sectionId        String           @map("section_id")
  description      String
  unitType         EstimateUnitType @map("unit_type")
  defaultQuantity  Decimal?         @map("default_quantity") @db.Decimal(12, 2)
  defaultUnitPrice Decimal?         @map("default_unit_price") @db.Decimal(12, 2)
  defaultNotes     String?          @map("default_notes") @db.Text
  isOptional       Boolean          @default(false) @map("is_optional")
  isActive         Boolean          @default(true) @map("is_active")
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  section EstimateTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("estimate_template_line_items")
}

model Estimate {
  id               String                   @id @default(cuid())
  leadId           String                   @map("lead_id")
  templateId       String?                  @map("template_id")
  templateCategory EstimateTemplateCategory @map("template_category")
  estimateNumber   String                   @unique @map("estimate_number")
  name             String
  status           EstimateStatus           @default(DRAFT)
  marginPercent    Decimal                  @default(0) @map("margin_percent") @db.Decimal(6, 3)
  discountEnabled  Boolean                  @default(false) @map("discount_enabled")
  discountPercent  Decimal                  @default(0) @map("discount_percent") @db.Decimal(6, 3)
  salesTaxPercent  Decimal                  @default(0) @map("sales_tax_percent") @db.Decimal(6, 3)
  validityDays     Int                      @default(30) @map("validity_days")
  notes            String?                  @db.Text
  exclusions       String?                  @db.Text
  subtotalCost     Decimal                  @map("subtotal_cost") @db.Decimal(12, 2)
  totalPrice       Decimal                  @map("total_price") @db.Decimal(12, 2)
  createdByUserId  String                   @map("created_by_user_id")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  lead      Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template  EstimateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User              @relation("EstimateCreatedBy", fields: [createdByUserId], references: [id])
  sections  EstimateSection[]
  tasks     Task[]

  @@index([leadId])
  @@index([templateCategory])
  @@map("estimates")
}

model EstimateSection {
  id         String   @id @default(cuid())
  estimateId String   @map("estimate_id")
  title      String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  estimate Estimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items    EstimateLineItem[]

  @@index([estimateId])
  @@map("estimate_sections")
}

model EstimateLineItem {
  id          String           @id @default(cuid())
  sectionId   String           @map("section_id")
  description String
  unitType    EstimateUnitType @map("unit_type")
  quantity    Decimal          @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal          @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal          @default(0) @map("line_total") @db.Decimal(12, 2)
  isOptional  Boolean          @default(false) @map("is_optional")
  notes       String?          @db.Text
  sortOrder   Int              @default(0) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  section EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("estimate_line_items")
}

// ─── Field Operations ───────────────────────────────────────────────────────

model Personnel {
  id        String  @id @default(cuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?
  email     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zipCode   String? @map("zip_code")

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactPhone    String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")

  trade           String?
  title           String?
  hourlyRate      Decimal?        @map("hourly_rate") @db.Decimal(10, 2)
  employmentType  EmploymentType  @default(W2) @map("employment_type")
  // Pay basis + what this person actually does. Both are profile defaults;
  // a JobPersonnelScope row overrides either one for a single job.
  payType         PayType         @default(HOURLY) @map("pay_type")
  workDescription String?         @map("work_description") @db.Text
  status          PersonnelStatus @default(ACTIVE)
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  entityName      String?         @map("entity_name")
  crewId          String?         @map("crew_id")
  userId          String?         @unique @map("user_id")
  notes           String?         @db.Text
  isActive        Boolean         @default(true) @map("is_active")
  deletedAt       DateTime?       @map("deleted_at")

  // Encrypted SSN (AES-256-GCM, src/lib/crypto/field-encryption.ts).
  // Ciphertext is self-describing "v{n}:{iv}:{tag}:{ct}"; keyVersion is
  // duplicated as a column so key-rotation sweeps can filter by version.
  ssnCiphertext String? @map("ssn_ciphertext")
  ssnLast4      String? @map("ssn_last4")
  ssnKeyVersion Int?    @map("ssn_key_version")

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  crew            Crew?               @relation(fields: [crewId], references: [id])
  user            User?               @relation("PersonnelUser", fields: [userId], references: [id])
  createdBy       User                @relation("PersonnelCreatedBy", fields: [createdByUserId], references: [id])
  documents       PersonnelDocument[]
  laborEntries    DailyLaborEntry[]
  payrollPayments PayrollPayment[]
  jobScopes       JobPersonnelScope[]

  @@index([lastName, firstName])
  @@index([crewId])
  @@index([isActive])
  @@map("personnel")
}

model PersonnelDocument {
  id               String                @id @default(cuid())
  personnelId      String                @map("personnel_id")
  type             PersonnelDocumentType @default(OTHER)
  fileName         String                @map("file_name")
  fileType         String                @map("file_type")
  fileSize         Int                   @map("file_size")
  storageKey       String                @map("storage_key")
  notes            String?
  uploadedByUserId String                @map("uploaded_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  personnel  Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("PersonnelDocUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([personnelId])
  @@map("personnel_documents")
}

model CostCode {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  phase     String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  laborEntries DailyLaborEntry[]

  @@map("cost_codes")
}

// Structured work areas for hotel/multifamily jobs ("Room 214", "Lobby",
// "Roof — Bldg A") with optional floor/unit granularity.
model JobArea {
  id        String   @id @default(cuid())
  jobId     String   @map("job_id")
  name      String
  floor     String?
  unit      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  laborEntries DailyLaborEntry[]
  photos       FieldPhoto[]

  @@unique([jobId, name])
  @@index([jobId])
  @@map("job_areas")
}

// Singleton OT policy (IntakeSettings pattern). Defaults follow FLSA:
// weekly-only overtime at 1.5x past 40h; no daily threshold.
model LaborSettings {
  id                  String   @id @default(cuid())
  otWeeklyThreshold   Decimal  @default(40) @map("ot_weekly_threshold") @db.Decimal(5, 2)
  otDailyThreshold    Decimal? @map("ot_daily_threshold") @db.Decimal(5, 2)
  otMultiplier        Decimal  @default(1.5) @map("ot_multiplier") @db.Decimal(4, 2)
  weekStartsOn        Int      @default(1) @map("week_starts_on")
  // Where "email weekly hours" sends payroll reports. ADMIN-configured; the
  // field app can only trigger a send to this fixed address.
  bookkeeperEmail     String?  @map("bookkeeper_email")
  // When true, payroll exports/emails only count hours on APPROVED logs.
  payrollApprovedOnly Boolean  @default(false) @map("payroll_approved_only")
  updatedByUserId     String?  @map("updated_by_user_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("labor_settings")
}

// Which CREW_LEAD (or other field user) runs which job. A lead can run
// several jobs and a hotel job can have several leads.
// Per-job override of a worker's pay basis and/or work description. A row
// exists only where the job differs from the person's profile default, so a
// missing row means "use the profile" — resolveWorkerScope() in
// src/lib/labor/scope.ts is the single reader. Null columns fall through
// individually: a job may override the description while keeping the
// profile's pay type.
model JobPersonnelScope {
  id              String   @id @default(cuid())
  jobId           String   @map("job_id")
  personnelId     String   @map("personnel_id")
  payType         PayType? @map("pay_type")
  workDescription String?  @map("work_description") @db.Text

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("JobPersonnelScopeCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([jobId, personnelId])
  @@index([personnelId])
  @@map("job_personnel_scopes")
}

model JobFieldAssignment {
  id              String   @id @default(cuid())
  jobId           String   @map("job_id")
  userId          String   @map("user_id")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User @relation("JobFieldAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("JobFieldAssignmentCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([jobId, userId])
  @@index([userId])
  @@map("job_field_assignments")
}

// One per (job, date): the shared header for the labor sheet and the daily
// jobsite narrative. The natural key doubles as the idempotent upsert key
// for offline retries.
model DailyLog {
  id            String         @id @default(cuid())
  jobId         String         @map("job_id")
  logDate       DateTime       @map("log_date") @db.Date
  status        DailyLogStatus @default(DRAFT)
  managerUserId String?        @map("manager_user_id")

  weatherSummary   String?   @map("weather_summary")
  weatherTempHighF Int?      @map("weather_temp_high_f")
  weatherTempLowF  Int?      @map("weather_temp_low_f")
  weatherPrecipIn  Decimal?  @map("weather_precip_in") @db.Decimal(5, 2)
  weatherWindMph   Int?      @map("weather_wind_mph")
  weatherSource    String?   @map("weather_source")
  weatherFetchedAt DateTime? @map("weather_fetched_at")

  workPerformed        String? @map("work_performed") @db.Text
  areasWorked          String? @map("areas_worked") @db.Text
  materialsDelivered   String? @map("materials_delivered") @db.Text
  equipmentUsed        String? @map("equipment_used") @db.Text
  subcontractorsOnsite String? @map("subcontractors_onsite") @db.Text
  inspectionsNotes     String? @map("inspections_notes") @db.Text
  delays               String? @db.Text
  safetyIssues         String? @map("safety_issues") @db.Text
  changeOrderItems     String? @map("change_order_items") @db.Text
  ownerInstructions    String? @map("owner_instructions") @db.Text
  officeFollowUps      String? @map("office_follow_ups") @db.Text
  tomorrowPlan         String? @map("tomorrow_plan") @db.Text
  notes                String? @db.Text

  submittedAt       DateTime? @map("submitted_at")
  submittedByUserId String?   @map("submitted_by_user_id")
  approvedAt        DateTime? @map("approved_at")
  approvedByUserId  String?   @map("approved_by_user_id")
  returnNote        String?   @map("return_note") @db.Text

  // Daily safety checklist (Phase 6)
  safetyToolboxTalk  Boolean @default(false) @map("safety_toolbox_talk")
  safetyPpeVerified  Boolean @default(false) @map("safety_ppe_verified")
  safetyHousekeeping Boolean @default(false) @map("safety_housekeeping")

  // Crew-lead sign-off: PNG via storage.ts, captured on submit
  signatureStorageKey String?   @map("signature_storage_key")
  signedAt            DateTime? @map("signed_at")
  signedByName        String?   @map("signed_by_name")

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job         Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  manager     User? @relation("DailyLogManager", fields: [managerUserId], references: [id])
  submittedBy User? @relation("DailyLogSubmittedBy", fields: [submittedByUserId], references: [id])
  approvedBy  User? @relation("DailyLogApprovedBy", fields: [approvedByUserId], references: [id])
  createdBy   User  @relation("DailyLogCreatedBy", fields: [createdByUserId], references: [id])

  laborEntries DailyLaborEntry[]
  photos       FieldPhoto[]
  issues       FieldIssue[]
  tasks        Task[]

  @@unique([jobId, logDate])
  @@index([jobId, logDate(sort: Desc)])
  @@index([status])
  @@map("daily_logs")
}

// One row per worker per day (split shifts allowed: same worker may have two
// rows on one log for different areas/cost codes). Ids are client-generated
// cuids so offline retries upsert instead of duplicating. Hours/costs are
// stored snapshots, always recomputed server-side on save.
model DailyLaborEntry {
  id          String   @id @default(cuid())
  dailyLogId  String   @map("daily_log_id")
  jobId       String   @map("job_id")
  workDate    DateTime @map("work_date") @db.Date
  personnelId String   @map("personnel_id")

  trade     String?
  jobAreaId String? @map("job_area_id")
  workArea  String? @map("work_area")

  // Minutes from midnight, local jobsite time. endMinutes may exceed 1440
  // for midnight-crossing shifts (1560 = 2:00 AM next day).
  startMinutes Int? @map("start_minutes")
  endMinutes   Int? @map("end_minutes")
  breakMinutes Int  @default(0) @map("break_minutes")

  totalHours   Decimal @default(0) @map("total_hours") @db.Decimal(5, 2)
  regularHours Decimal @default(0) @map("regular_hours") @db.Decimal(5, 2)
  otHours      Decimal @default(0) @map("ot_hours") @db.Decimal(5, 2)

  regularRate Decimal @default(0) @map("regular_rate") @db.Decimal(10, 2)
  otRate      Decimal @default(0) @map("ot_rate") @db.Decimal(10, 2)
  totalCost   Decimal @default(0) @map("total_cost") @db.Decimal(12, 2)

  costCodeId   String? @map("cost_code_id")
  phase        String?
  budgetLineId String? @map("budget_line_id")

  isAbsent      Boolean @default(false) @map("is_absent")
  isLate        Boolean @default(false) @map("is_late")
  leftEarly     Boolean @default(false) @map("left_early")
  absenceReason String? @map("absence_reason")
  notes         String? @db.Text

  // Check-in/out with GPS confirmation (Phase 6)
  checkInAt   DateTime? @map("check_in_at")
  checkOutAt  DateTime? @map("check_out_at")
  checkInLat  Decimal?  @map("check_in_lat") @db.Decimal(10, 7)
  checkInLng  Decimal?  @map("check_in_lng") @db.Decimal(10, 7)
  checkOutLat Decimal?  @map("check_out_lat") @db.Decimal(10, 7)
  checkOutLng Decimal?  @map("check_out_lng") @db.Decimal(10, 7)

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Set when this entry's cost was covered by a payroll payment. Paid
  // entries refuse hour/cost changes and drop out of the accrued
  // field-labor cost stream (the posted JobExpense carries it instead).
  payrollPaymentId String? @map("payroll_payment_id")

  dailyLog       DailyLog        @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  personnel      Personnel       @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  jobArea        JobArea?        @relation(fields: [jobAreaId], references: [id], onDelete: SetNull)
  costCode       CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  budgetLine     BudgetLine?     @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("LaborEntryCreatedBy", fields: [createdByUserId], references: [id])
  payrollPayment PayrollPayment? @relation(fields: [payrollPaymentId], references: [id], onDelete: SetNull)

  budgetAllocations BudgetAllocation[]
  photos            FieldPhoto[]       @relation("LaborEntryPhotos")

  @@index([jobId, workDate])
  @@index([personnelId, workDate])
  @@index([dailyLogId])
  @@index([costCodeId])
  @@index([budgetLineId])
  @@index([payrollPaymentId])
  @@map("daily_labor_entries")
}

// One row = one worker paid for one payroll week. Creating it posts LABOR
// JobExpenses (one per job worked, split by the entries' cost snapshots)
// and stamps the covered entries; deleting it (admin undo) cascades the
// expenses away and releases the entries.
model PayrollPayment {
  id           String         @id @default(cuid())
  personnelId  String         @map("personnel_id")
  weekStart    DateTime       @map("week_start") @db.Date
  regularHours Decimal        @map("regular_hours") @db.Decimal(6, 2)
  otHours      Decimal        @map("ot_hours") @db.Decimal(6, 2)
  grossAmount  Decimal        @map("gross_amount") @db.Decimal(12, 2)
  method       PaymentMethod?
  reference    String?
  paidAt       DateTime       @default(now()) @map("paid_at")
  paidByUserId String         @map("paid_by_user_id")

  personnel Personnel         @relation(fields: [personnelId], references: [id], onDelete: Restrict)
  paidBy    User              @relation("PayrollPaymentsMade", fields: [paidByUserId], references: [id])
  expenses  JobExpense[]
  entries   DailyLaborEntry[]

  @@unique([personnelId, weekStart])
  @@index([weekStart])
  @@map("payroll_payments")
}

// Field photos: job-scoped, optionally pinned to a daily log, labor entry,
// issue, and/or area. Separate from File (lead-anchored) on purpose — the
// gallery filters (job/date/category/area) get their own indexes. Bytes go
// through src/lib/files/storage.ts. Ids may be client-generated for
// offline-retry safety.
model FieldPhoto {
  id                String             @id @default(cuid())
  jobId             String             @map("job_id")
  dailyLogId        String?            @map("daily_log_id")
  dailyLaborEntryId String?            @map("daily_labor_entry_id")
  fieldIssueId      String?            @map("field_issue_id")
  jobAreaId         String?            @map("job_area_id")
  photoDate         DateTime           @map("photo_date") @db.Date
  category          FieldPhotoCategory @default(PROGRESS)
  caption           String?
  areaText          String?            @map("area_text")
  fileName          String             @map("file_name")
  fileType          String             @map("file_type")
  fileSize          Int                @map("file_size")
  storageKey        String             @map("storage_key")
  gpsLat            Decimal?           @map("gps_lat") @db.Decimal(10, 7)
  gpsLng            Decimal?           @map("gps_lng") @db.Decimal(10, 7)
  takenByUserId     String             @map("taken_by_user_id")
  createdAt         DateTime           @default(now()) @map("created_at")

  job        Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dailyLog   DailyLog?        @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  laborEntry DailyLaborEntry? @relation("LaborEntryPhotos", fields: [dailyLaborEntryId], references: [id], onDelete: SetNull)
  fieldIssue FieldIssue?      @relation(fields: [fieldIssueId], references: [id], onDelete: SetNull)
  jobArea    JobArea?         @relation(fields: [jobAreaId], references: [id], onDelete: SetNull)
  takenBy    User             @relation("FieldPhotoTakenBy", fields: [takenByUserId], references: [id])

  @@index([jobId, photoDate(sort: Desc)])
  @@index([jobId, category])
  @@index([dailyLogId])
  @@index([fieldIssueId])
  @@map("field_photos")
}

// Field-flagged items needing office attention. Source of truth for field
// issues; when assigned (or typed OFFICE_FOLLOW_UP) the service creates a
// linked Task so it shows in the office task queue. Sync is one-way:
// resolving the issue completes the Task, never the reverse.
model FieldIssue {
  id               String         @id @default(cuid())
  jobId            String         @map("job_id")
  dailyLogId       String?        @map("daily_log_id")
  type             FieldIssueType @default(OFFICE_FOLLOW_UP)
  title            String
  description      String?        @db.Text
  priority         Priority       @default(MEDIUM)
  status           TaskStatus     @default(PENDING)
  assignedUserId   String?        @map("assigned_user_id")
  dueAt            DateTime?      @map("due_at")
  taskId           String?        @unique @map("task_id")
  raisedByUserId   String         @map("raised_by_user_id")
  resolvedAt       DateTime?      @map("resolved_at")
  resolvedByUserId String?        @map("resolved_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dailyLog   DailyLog?    @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  task       Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignedTo User?        @relation("FieldIssueAssignedTo", fields: [assignedUserId], references: [id])
  raisedBy   User         @relation("FieldIssueRaisedBy", fields: [raisedByUserId], references: [id])
  resolvedBy User?        @relation("FieldIssueResolvedBy", fields: [resolvedByUserId], references: [id])
  photos     FieldPhoto[]

  @@index([jobId, status])
  @@index([assignedUserId, status])
  @@map("field_issues")
}

// ─── Trade Workflow Templates ───────────────────────────────────────────────
// A template is phases → tasks for a type of work. Applying one or more to a
// job composes Core + the selected trades + a permit branch and generates
// ORDINARY tasks (see the workflow columns on Task). Versions are immutable
// once a job references them; jobs pin the version they were applied with.
// Full write-up: docs/project-memory/features/workflows.md

/// CORE and TRADE compose together on a job (Core always present). A
/// VIOLATION template is applied alone to a code-violation case — never with
/// Core — and carries its own `determine_permit_requirement` gate.
enum WorkflowTemplateKind {
  CORE
  TRADE
  VIOLATION
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

/// Functional roles a template assigns work to. Deliberately NOT RoleName:
/// CareyOS owns the seven login roles, and a "superintendent" is a job-team
/// slot, not a login level. Resolved per job via team slots, the job's
/// PM/sales rep fields, then admin defaults.
enum WorkflowRole {
  PROJECT_MANAGER
  SALES_REP
  SUPERINTENDENT
  PERMIT_COORDINATOR
  ESTIMATOR
  OFFICE_ADMIN
  PURCHASING
  ACCOUNTING
  QUALITY_CONTROL
  /// Code-violation cases: resolves to CodeViolationCase.caseManagerId.
  CASE_MANAGER
}

/// What a task's due-date offset counts from. JOB_CREATED is "subject
/// created" — a job's or a violation case's createdAt; the name is kept
/// because every seeded template's content hash contains it.
enum WorkflowAnchor {
  JOB_CREATED
  APPLIED_AT
  TARGET_START
  PHASE_START
  PREDECESSOR
  /// Violation cases only: the case's current compliance deadline (negative offsets allowed).
  COMPLIANCE_DEADLINE
  /// Violation cases only: the next scheduled hearing (negative offsets allowed).
  HEARING_DATE
}

enum WorkflowEvidenceType {
  ATTACHMENT
  PHOTO
  PERMIT_NUMBER
  PERMIT_DETERMINATION
  INSPECTION_RESULT
  PAYMENT_STATUS
  NOTE
  // ── Code-violation cases ──
  /// The agency's written compliance confirmation is recorded on the case.
  AGENCY_CONFIRMATION
  /// The latest hearing has an outcome.
  HEARING_RESULT
  /// Param STOPPED | OFFICIAL_BALANCE | PAID | RESOLVED | LIEN_RELEASED.
  FINE_STATUS
  /// Param EXISTS (≥ 1 item) | COMPLETE (every item verified or withdrawn).
  VIOLATION_ITEMS
  /// Param EXISTS (a job is linked) | WORKFLOW (it has a workflow) | COMPLETE (corrective work stamped complete).
  LINKED_JOB
  /// Param NUMBER | ISSUED | FINAL, read from the linked job's permits.
  LINKED_JOB_PERMIT
}

enum WorkflowPermitCondition {
  REQUIRED
  NOT_REQUIRED
}

enum WorkflowPermitStatus {
  UNDETERMINED
  REQUIRED
  NOT_REQUIRED
}

enum JobWorkflowStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// BLOCKING holds the dependent until the predecessor closes; DATE_ONLY only
/// feeds its due date.
enum TaskDependencyKind {
  BLOCKING
  DATE_ONLY
}

model WorkflowTemplate {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  kind        WorkflowTemplateKind
  trade       String?
  description String?              @db.Text
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  versions          WorkflowTemplateVersion[]
  serviceCategories WorkflowTemplateServiceCategory[]
  modules           JobWorkflowModule[]

  @@map("workflow_templates")
}

/// Which lead service categories suggest this template when applying.
model WorkflowTemplateServiceCategory {
  templateId        String @map("template_id")
  serviceCategoryId String @map("service_category_id")

  template        WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory  @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@id([templateId, serviceCategoryId])
  @@map("workflow_template_service_categories")
}

model WorkflowTemplateVersion {
  id                String                @id @default(cuid())
  templateId        String                @map("template_id")
  version           Int
  status            WorkflowVersionStatus @default(DRAFT)
  changeNotes       String?               @map("change_notes") @db.Text
  // [{ key, label, description?, default }]
  scopeToggles      Json                  @default("[]") @map("scope_toggles")
  // Hash of the normalised content so the seeder can tell "unchanged" from
  // "someone edited the seed file without bumping the version".
  contentHash       String                @map("content_hash")
  sourceVersionId   String?               @map("source_version_id")
  createdByUserId   String?               @map("created_by_user_id")
  publishedByUserId String?               @map("published_by_user_id")
  publishedAt       DateTime?             @map("published_at")
  supersededAt      DateTime?             @map("superseded_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  template     WorkflowTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  phases       WorkflowPhase[]
  tasks        WorkflowTaskTemplate[]
  dependencies WorkflowTaskDependency[]
  modules      JobWorkflowModule[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("workflow_template_versions")
}

model WorkflowPhase {
  id              String                   @id @default(cuid())
  versionId       String                   @map("version_id")
  key             String
  name            String
  // Where the phase sits when Core and trades interleave: Job Setup 100 …
  // Core Closeout 1000. Same band → Core first, then module order.
  band            Int
  sortOrder       Int                      @default(0) @map("sort_order")
  description     String?                  @db.Text
  // Shown in the UI under the phase heading. The No-Permit phases carry the
  // legal warning here.
  note            String?                  @db.Text
  conditionPermit WorkflowPermitCondition? @map("condition_permit")

  version WorkflowTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tasks   WorkflowTaskTemplate[]

  @@unique([versionId, key])
  @@map("workflow_phases")
}

model WorkflowTaskTemplate {
  id                    String                   @id @default(cuid())
  versionId             String                   @map("version_id")
  phaseId               String                   @map("phase_id")
  key                   String
  title                 String
  description           String?                  @db.Text
  role                  WorkflowRole
  priority              Priority                 @default(MEDIUM)
  anchor                WorkflowAnchor           @default(PREDECESSOR)
  dueOffsetBusinessDays Int                      @default(0) @map("due_offset_business_days")
  durationBusinessDays  Int?                     @map("duration_business_days")
  autoActivate          Boolean                  @default(false) @map("auto_activate")
  blocking              Boolean                  @default(false)
  requiredEvidence      WorkflowEvidenceType?    @map("required_evidence")
  requiredEvidenceParam String?                  @map("required_evidence_param")
  // [{ key, label, condition? }]
  checklist             Json                     @default("[]")
  conditionPermit       WorkflowPermitCondition? @map("condition_permit")
  conditionAnyOf        String[]                 @default([]) @map("condition_any_of")
  conditionAllOf        String[]                 @default([]) @map("condition_all_of")
  // A trade task that replaces a Core task of the same meaning (e.g. the
  // roofing final inspection replaces Core's generic one).
  overridesCoreKey      String?                  @map("overrides_core_key")
  sortOrder             Int                      @default(0) @map("sort_order")

  version WorkflowTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  phase   WorkflowPhase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([phaseId])
  @@map("workflow_task_templates")
}

/// dependsOnRef is "task_key" within the same version or "core:task_key".
model WorkflowTaskDependency {
  id           String             @id @default(cuid())
  versionId    String             @map("version_id")
  taskKey      String             @map("task_key")
  dependsOnRef String             @map("depends_on_ref")
  kind         TaskDependencyKind @default(BLOCKING)

  version WorkflowTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, taskKey, dependsOnRef])
  @@map("workflow_task_dependencies")
}

/// Company-wide fallback assignee per functional role.
model WorkflowRoleDefault {
  id              String       @id @default(cuid())
  role            WorkflowRole @unique
  userId          String       @map("user_id")
  updatedByUserId String?      @map("updated_by_user_id")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user User @relation("WorkflowRoleDefaultUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("workflow_role_defaults")
}

/// One applied workflow. Owned by EXACTLY ONE subject — a Job or a
/// CodeViolationCase — enforced by a CHECK constraint in the migration
/// (Prisma has no @@check). The `Job` prefix is historical: modules, team
/// slots and tasks key on `instanceId` only, so nothing else knows which
/// kind of subject owns the instance.
model JobWorkflowInstance {
  id                       String               @id @default(cuid())
  jobId                    String?              @unique @map("job_id")
  violationCaseId          String?              @unique @map("violation_case_id")
  status                   JobWorkflowStatus    @default(ACTIVE)
  permitStatus             WorkflowPermitStatus @default(UNDETERMINED) @map("permit_status")
  permitDeterminedByUserId String?              @map("permit_determined_by_user_id")
  permitDeterminedAt       DateTime?            @map("permit_determined_at")
  permitNotes              String?              @map("permit_notes") @db.Text
  permitDocumentFileId     String?              @map("permit_document_file_id")
  // { [toggleKey]: boolean } — job overrides of the version defaults.
  scopeToggles             Json                 @default("{}") @map("scope_toggles")
  appliedByUserId          String               @map("applied_by_user_id")
  appliedAt                DateTime             @default(now()) @map("applied_at")
  lastReconciledAt         DateTime?            @map("last_reconciled_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  job                Job?                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  violationCase      CodeViolationCase?      @relation(fields: [violationCaseId], references: [id], onDelete: Cascade)
  appliedBy          User                    @relation("WorkflowAppliedBy", fields: [appliedByUserId], references: [id])
  permitDeterminedBy User?                   @relation("WorkflowPermitDeterminedBy", fields: [permitDeterminedByUserId], references: [id])
  modules            JobWorkflowModule[]
  team               JobWorkflowTeamMember[]
  tasks              Task[]

  @@map("job_workflow_instances")
}

/// One applied template (Core included), pinned to the version it was
/// applied with. Removal is soft so completed work stays attributable.
model JobWorkflowModule {
  id                String    @id @default(cuid())
  instanceId        String    @map("instance_id")
  templateId        String    @map("template_id")
  templateKey       String    @map("template_key")
  templateVersionId String    @map("template_version_id")
  addedByUserId     String    @map("added_by_user_id")
  addedAt           DateTime  @default(now()) @map("added_at")
  removedAt         DateTime? @map("removed_at")
  removedByUserId   String?   @map("removed_by_user_id")
  removeReason      String?   @map("remove_reason") @db.Text

  instance        JobWorkflowInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  template        WorkflowTemplate        @relation(fields: [templateId], references: [id])
  templateVersion WorkflowTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([instanceId, templateKey])
  @@index([templateVersionId])
  @@map("job_workflow_modules")
}

model JobWorkflowTeamMember {
  id         String       @id @default(cuid())
  instanceId String       @map("instance_id")
  role       WorkflowRole
  userId     String       @map("user_id")

  instance JobWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User                @relation("WorkflowTeamUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, role])
  @@index([userId])
  @@map("job_workflow_team_members")
}

/// `task` waits on `dependsOn`. source = "workflow" | "manual".
model TaskDependency {
  id              String             @id @default(cuid())
  taskId          String             @map("task_id")
  dependsOnTaskId String             @map("depends_on_task_id")
  kind            TaskDependencyKind @default(BLOCKING)
  source          String             @default("workflow")
  createdByUserId String?            @map("created_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at")

  task      Task @relation("TaskDependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependencyOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// ─── Code Violations ────────────────────────────────────────────────────────
//
// A CodeViolationCase is anchored to a Lead (the property + owner/customer
// record) and optionally to a Job (the corrective construction). Its work
// is ordinary Tasks generated by a VIOLATION workflow template through the
// same engine jobs use; the case itself holds the agency facts, the money
// (official figures only — the accrual ESTIMATE is computed, never stored)
// and the resolution/closure record.

/// Lifecycle only. "Where the case is" (awaiting reinspection, hearing
/// scheduled, lien recorded…) is derived from the workflow phase, the flags
/// and the ledger — storing it twice would drift the moment a step closed.
enum CodeViolationStatus {
  NEW
  ACTIVE
  ON_HOLD
  APPEALED
  /// Agency confirmed compliance; fines or a lien may still be open.
  COMPLIED
  CLOSED
  CANCELLED
}

enum CodeViolationSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum CodeViolationItemStatus {
  OPEN
  IN_PROGRESS
  CORRECTED
  /// The agency (or a final internal check) accepted the correction.
  VERIFIED
  WITHDRAWN
}

enum CodeViolationHearingType {
  SPECIAL_MAGISTRATE
  CODE_ENFORCEMENT_BOARD
  APPEAL
  LIEN_REDUCTION
  OTHER
}

enum CodeViolationHearingStatus {
  SCHEDULED
  CONTINUED
  HELD
  CANCELLED
}

enum CodeViolationHearingOutcome {
  COMPLIANCE_ORDERED
  FINE_IMPOSED
  CONTINUED
  DISMISSED
  FOUND_IN_COMPLIANCE
  LIEN_AUTHORIZED
  MITIGATION_GRANTED
  MITIGATION_DENIED
  OTHER
}

/// Agency inspections requested by the CRM (initial, reinspection, final).
/// Distinct from JobPermitInspection; the result reuses PermitInspectionResult.
enum CodeViolationInspectionStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CodeViolationExtensionStatus {
  REQUESTED
  GRANTED
  DENIED
  WITHDRAWN
}

enum CodeViolationMitigationStatus {
  NONE
  REQUESTED
  GRANTED
  PARTIALLY_GRANTED
  DENIED
}

enum CodeViolationLienStatus {
  NONE
  RECORDED
  RELEASED
}

/// The fine ledger. OFFICIAL_BALANCE is an absolute figure as of a date;
/// PAYMENT reduces; FINE_IMPOSED / ADMIN_COST add; the rest carry facts
/// (accrual start/stop, lien recorded/released, mitigation) with an amount
/// where one applies. The case's snapshot columns mirror the latest entries.
enum CodeViolationFineEntryType {
  OFFICIAL_BALANCE
  ACCRUAL_STARTED
  ACCRUAL_STOPPED
  FINE_IMPOSED
  ADMIN_COST
  PAYMENT
  MITIGATION_REQUESTED
  MITIGATION_DECIDED
  LIEN_RECORDED
  LIEN_RELEASED
  ADJUSTMENT
  NOTE
}

/// The case timeline, same shape as TaskEvent: NOTE rows are the only
/// editable kind; everything else records something that happened.
enum CodeViolationEventType {
  NOTE
  CREATED
  STATUS_CHANGED
  ASSIGNED
  DEADLINE_CHANGED
  EXTENSION_REQUESTED
  EXTENSION_DECIDED
  HEARING_SCHEDULED
  HEARING_RESULT
  INSPECTION_REQUESTED
  INSPECTION_RESULT
  ITEM_ADDED
  ITEM_STATUS_CHANGED
  FINE_ENTRY
  LIEN_RECORDED
  LIEN_RELEASED
  AGENCY_CONFIRMED
  CORRECTIVE_WORK_COMPLETED
  JOB_LINKED
  JOB_UNLINKED
  WORKFLOW_APPLIED
  CLOSED
  REOPENED
  FILE_ATTACHED
  COMMUNICATION_LOGGED
}

/// Configurable violation categories (seeded with 22; a table so admins can
/// edit them without a deploy and items keep their category through renames).
model CodeViolationCategory {
  id                       String               @id @default(cuid())
  key                      String               @unique
  name                     String
  description              String?              @db.Text
  defaultResponsibleTrade  String?              @map("default_responsible_trade")
  defaultPermitRequirement WorkflowPermitStatus @default(UNDETERMINED) @map("default_permit_requirement")
  /// Categories that usually mean corrective construction (roofing, structural…).
  defaultConstructionRequired Boolean           @default(false) @map("default_construction_required")
  sortOrder                Int                  @default(0) @map("sort_order")
  isActive                 Boolean              @default(true) @map("is_active")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  items CodeViolationItem[]

  @@map("code_violation_categories")
}

model CodeViolationCase {
  id               String  @id @default(cuid())
  /// "CV-00001", from the code_violation_case_number_seq sequence (see migration).
  caseNumber       String  @unique @map("case_number")
  agencyCaseNumber String? @map("agency_case_number")
  /// The property + owner/customer record. Required: the address lives here.
  leadId           String  @map("lead_id")
  /// The corrective construction job, once one exists.
  jobId            String? @map("job_id")
  parcelNumber     String? @map("parcel_number")
  /// Owner as printed on the notice; the lead may differ.
  ownerNameSnapshot String? @map("owner_name_snapshot")
  jurisdiction     String?
  department       String?
  officerName      String? @map("officer_name")
  officerPhone     String? @map("officer_phone")
  officerEmail     String? @map("officer_email")
  noticeType       String? @map("notice_type")
  title            String
  summary          String? @db.Text

  receivedAt       DateTime  @map("received_at")
  noticeDate       DateTime? @map("notice_date")
  originalDeadline DateTime? @map("original_deadline")
  /// Schedule anchor COMPLIANCE_DEADLINE. Moves through the deadline-change path only.
  currentDeadline  DateTime? @map("current_deadline")
  /// Denormalised from hearings; schedule anchor HEARING_DATE.
  nextHearingAt    DateTime? @map("next_hearing_at")
  appealDeadline   DateTime? @map("appeal_deadline")

  status          CodeViolationStatus   @default(NEW)
  priority        Priority              @default(MEDIUM)
  severity        CodeViolationSeverity @default(MODERATE)
  caseManagerId   String?               @map("case_manager_id")
  /// "Responsible team" — which functional role owns the fix.
  responsibleRole WorkflowRole?         @map("responsible_role")

  // Flags. Permit-required is NOT here: it is the workflow instance's
  // permitStatus, exactly as on a job.
  hearingRequired      Boolean @default(false) @map("hearing_required")
  reinspectionRequired Boolean @default(true) @map("reinspection_required")
  emergency            Boolean @default(false)
  constructionRequired Boolean @default(false) @map("construction_required")

  // Current extension request (history in CodeViolationExtension).
  extensionStatus      CodeViolationExtensionStatus? @map("extension_status")
  extensionRequestedAt DateTime?                     @map("extension_requested_at")
  extensionDeadline    DateTime?                     @map("extension_deadline")

  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(12, 2)
  actualCost    Decimal? @map("actual_cost") @db.Decimal(12, 2)

  // ── Fines: OFFICIAL figures, entered. The system ESTIMATE is computed
  // on read from the terms below (see src/lib/violations/fines.ts) and is
  // never stored, so the two can never be confused.
  initialFine               Decimal?  @map("initial_fine") @db.Decimal(12, 2)
  dailyFine                 Decimal?  @map("daily_fine") @db.Decimal(12, 2)
  fineAccrualStartDate      DateTime? @map("fine_accrual_start_date")
  /// The OFFICIAL stop date. Corrective-work completion never sets this.
  fineAccrualStoppedAt      DateTime? @map("fine_accrual_stopped_at")
  adminCosts                Decimal   @default(0) @map("admin_costs") @db.Decimal(12, 2)
  officialBalance           Decimal?  @map("official_balance") @db.Decimal(12, 2)
  officialBalanceAsOf       DateTime? @map("official_balance_as_of")
  amountPaid                Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  mitigationStatus          CodeViolationMitigationStatus @default(NONE) @map("mitigation_status")
  mitigationRequestedAmount Decimal?  @map("mitigation_requested_amount") @db.Decimal(12, 2)
  mitigationGrantedAmount   Decimal?  @map("mitigation_granted_amount") @db.Decimal(12, 2)
  mitigationRequestedAt     DateTime? @map("mitigation_requested_at")
  mitigationDecidedAt       DateTime? @map("mitigation_decided_at")
  /// ADMIN/MANAGER override of the system estimate, with a reason (audited).
  fineEstimateOverride      Decimal?  @map("fine_estimate_override") @db.Decimal(12, 2)
  fineEstimateOverrideReason String?  @map("fine_estimate_override_reason") @db.Text
  fineEstimateOverrideAt    DateTime? @map("fine_estimate_override_at")
  fineTermsUpdatedAt        DateTime? @map("fine_terms_updated_at")
  lienStatus                CodeViolationLienStatus @default(NONE) @map("lien_status")
  lienAmount                Decimal?  @map("lien_amount") @db.Decimal(12, 2)
  lienRecordedAt            DateTime? @map("lien_recorded_at")
  lienInstrumentNumber      String?   @map("lien_instrument_number")
  lienBookPage              String?   @map("lien_book_page")
  lienReleasedAt            DateTime? @map("lien_released_at")
  lienReleaseInstrumentNumber String? @map("lien_release_instrument_number")

  // ── Resolution. Construction completion ≠ compliance: the agency's
  // confirmation is a separate, later fact and the closure gate.
  correctiveWorkCompletedAt DateTime?               @map("corrective_work_completed_at")
  reinspectionRequestedAt   DateTime?               @map("reinspection_requested_at")
  finalInspectionResult     PermitInspectionResult? @map("final_inspection_result")
  agencyConfirmedAt         DateTime?               @map("agency_confirmed_at")
  agencyConfirmedByName     String?                 @map("agency_confirmed_by_name")
  agencyConfirmationMethod  String?                 @map("agency_confirmation_method")
  agencyConfirmationRef     String?                 @map("agency_confirmation_ref")
  agencyConfirmationFileId  String?                 @map("agency_confirmation_file_id")
  officialComplianceDate    DateTime?               @map("official_compliance_date")
  permitClosedAt            DateTime?               @map("permit_closed_at")
  fineResolvedAt            DateTime?               @map("fine_resolved_at")
  closedAt                  DateTime?               @map("closed_at")
  closedByUserId            String?                 @map("closed_by_user_id")
  closeReason               String?                 @map("close_reason") @db.Text
  /// Set when an ADMIN/MANAGER closed past the blockers (audited separately).
  closureOverrideReason     String?                 @map("closure_override_reason") @db.Text

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lead        Lead  @relation(fields: [leadId], references: [id])
  job         Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  caseManager User? @relation("ViolationCaseManager", fields: [caseManagerId], references: [id])
  createdBy   User  @relation("ViolationCaseCreatedBy", fields: [createdByUserId], references: [id])
  closedBy    User? @relation("ViolationCaseClosedBy", fields: [closedByUserId], references: [id])

  workflow       JobWorkflowInstance?
  items          CodeViolationItem[]
  hearings       CodeViolationHearing[]
  inspections    CodeViolationInspection[]
  extensions     CodeViolationExtension[]
  fineEntries    CodeViolationFineEntry[]
  events         CodeViolationEvent[]
  reminderLogs   CodeViolationReminderLog[]
  tasks          Task[]
  files          File[]
  communications Communication[]

  @@index([leadId])
  @@index([jobId])
  @@index([status])
  @@index([caseManagerId, status])
  @@index([currentDeadline])
  @@index([nextHearingAt])
  @@index([agencyCaseNumber])
  @@index([jurisdiction])
  @@map("code_violation_cases")
}

/// One cited violation on a notice. A notice usually carries several.
model CodeViolationItem {
  id                 String                  @id @default(cuid())
  caseId             String                  @map("case_id")
  itemNumber         Int                     @map("item_number")
  categoryId         String?                 @map("category_id")
  codeSection        String?                 @map("code_section")
  description        String                  @db.Text
  correctiveAction   String?                 @map("corrective_action") @db.Text
  responsibleTrade   String?                 @map("responsible_trade")
  permitRequirement  WorkflowPermitStatus    @default(UNDETERMINED) @map("permit_requirement")
  assignedUserId     String?                 @map("assigned_user_id")
  assignedRole       WorkflowRole?           @map("assigned_role")
  contractorName     String?                 @map("contractor_name")
  status             CodeViolationItemStatus @default(OPEN)
  targetCompletionAt DateTime?               @map("target_completion_at")
  actualCompletionAt DateTime?               @map("actual_completion_at")
  verifiedAt         DateTime?               @map("verified_at")
  estimatedCost      Decimal?                @map("estimated_cost") @db.Decimal(12, 2)
  actualCost         Decimal?                @map("actual_cost") @db.Decimal(12, 2)
  sortOrder          Int                     @default(0) @map("sort_order")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  case       CodeViolationCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category   CodeViolationCategory? @relation(fields: [categoryId], references: [id])
  assignedTo User?                  @relation("ViolationItemAssignedTo", fields: [assignedUserId], references: [id])
  tasks      Task[]
  files      File[]

  @@unique([caseId, itemNumber])
  @@index([caseId, status])
  @@index([assignedUserId, status])
  @@map("code_violation_items")
}

model CodeViolationHearing {
  id                 String                       @id @default(cuid())
  caseId             String                       @map("case_id")
  type               CodeViolationHearingType     @default(SPECIAL_MAGISTRATE)
  status             CodeViolationHearingStatus   @default(SCHEDULED)
  scheduledAt        DateTime                     @map("scheduled_at")
  location           String?
  attendeeUserId     String?                      @map("attendee_user_id")
  caseNumberAtHearing String?                     @map("case_number_at_hearing")
  outcome            CodeViolationHearingOutcome?
  outcomeNotes       String?                      @map("outcome_notes") @db.Text
  orderDeadline      DateTime?                    @map("order_deadline")
  orderedFineAmount  Decimal?                     @map("ordered_fine_amount") @db.Decimal(12, 2)
  orderedDailyFine   Decimal?                     @map("ordered_daily_fine") @db.Decimal(12, 2)
  /// A continued hearing points at its replacement.
  continuedToId      String?                      @unique @map("continued_to_id")
  orderFileId        String?                      @map("order_file_id")
  notes              String?                      @db.Text
  createdByUserId    String                       @map("created_by_user_id")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  case        CodeViolationCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attendee    User?                 @relation("ViolationHearingAttendee", fields: [attendeeUserId], references: [id])
  continuedTo CodeViolationHearing? @relation("HearingContinuation", fields: [continuedToId], references: [id])
  continuedFrom CodeViolationHearing? @relation("HearingContinuation")

  @@index([caseId, scheduledAt])
  @@index([scheduledAt])
  @@map("code_violation_hearings")
}

/// An AGENCY inspection on the case (initial, reinspection, final).
model CodeViolationInspection {
  id                String                        @id @default(cuid())
  caseId            String                        @map("case_id")
  /// "INITIAL" | "REINSPECTION" | "FINAL" — free text on purpose.
  kind              String                        @default("REINSPECTION")
  status            CodeViolationInspectionStatus @default(REQUESTED)
  requestedAt       DateTime                      @default(now()) @map("requested_at")
  requestedByUserId String?                       @map("requested_by_user_id")
  scheduledFor      DateTime?                     @map("scheduled_for")
  attendeeUserId    String?                       @map("attendee_user_id")
  completedAt       DateTime?                     @map("completed_at")
  result            PermitInspectionResult?
  inspectorName     String?                       @map("inspector_name")
  notes             String?                       @db.Text
  /// Items the agency re-cited on a FAIL; they reopen.
  failedItemIds     String[]                      @default([]) @map("failed_item_ids")
  reportFileId      String?                       @map("report_file_id")
  /// The workflow step the result was recorded on, when there was one.
  taskId            String?                       @map("task_id")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")

  case     CodeViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attendee User?             @relation("ViolationInspectionAttendee", fields: [attendeeUserId], references: [id])

  @@index([caseId, requestedAt])
  @@index([scheduledFor])
  @@map("code_violation_inspections")
}

model CodeViolationExtension {
  id                String                       @id @default(cuid())
  caseId            String                       @map("case_id")
  requestedAt       DateTime                     @default(now()) @map("requested_at")
  requestedDeadline DateTime                     @map("requested_deadline")
  reason            String?                      @db.Text
  status            CodeViolationExtensionStatus @default(REQUESTED)
  decidedAt         DateTime?                    @map("decided_at")
  grantedDeadline   DateTime?                    @map("granted_deadline")
  decisionNotes     String?                      @map("decision_notes") @db.Text
  requestFileId     String?                      @map("request_file_id")
  createdByUserId   String                       @map("created_by_user_id")
  createdAt         DateTime                     @default(now()) @map("created_at")

  case CodeViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("code_violation_extensions")
}

/// The fine ledger: every official figure with its date, so "official
/// balance" has a history and the snapshot on the case is reproducible.
model CodeViolationFineEntry {
  id              String                     @id @default(cuid())
  caseId          String                     @map("case_id")
  type            CodeViolationFineEntryType
  amount          Decimal?                   @db.Decimal(12, 2)
  effectiveAt     DateTime                   @map("effective_at")
  reference       String?
  notes           String?                    @db.Text
  fileId          String?                    @map("file_id")
  createdByUserId String                     @map("created_by_user_id")
  createdAt       DateTime                   @default(now()) @map("created_at")

  case CodeViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, effectiveAt])
  @@map("code_violation_fine_entries")
}

model CodeViolationEvent {
  id          String                 @id @default(cuid())
  caseId      String                 @map("case_id")
  itemId      String?                @map("item_id")
  actorUserId String?                @map("actor_user_id")
  type        CodeViolationEventType
  body        String?                @db.Text
  fromValue   String?                @map("from_value")
  toValue     String?                @map("to_value")
  editedAt    DateTime?              @map("edited_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  case  CodeViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?             @relation("ViolationEventActor", fields: [actorUserId], references: [id])

  @@index([caseId, createdAt])
  @@map("code_violation_events")
}

/// Deadline-reminder and escalation ledger for the violation-deadlines cron.
/// One row per (case, deadline kind, dated entity, offset) — insert before
/// send, so a run that dies half-way sends nothing twice; delete on provider
/// failure so the next run retries. entityId carries the date ("<id>@<ymd>"),
/// so a moved deadline starts a fresh series by itself.
model CodeViolationReminderLog {
  id               String   @id @default(cuid())
  caseId           String   @map("case_id")
  kind             String
  entityId         String   @map("entity_id")
  /// "d30" … "d0", "od:<ymd>" for daily overdue, "esc:<level>" for escalations.
  offsetKey        String   @map("offset_key")
  recipientUserIds String[] @default([]) @map("recipient_user_ids")
  channel          String   @default("email")
  sentAt           DateTime @default(now()) @map("sent_at")

  case CodeViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, kind, entityId, offsetKey])
  @@map("code_violation_reminder_logs")
}
