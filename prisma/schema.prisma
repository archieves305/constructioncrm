  createdAt   DateTime     @default(now()) @map("created_at")

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id])

  @@index([jobId])
  @@map("review_requests")
}

model Referral {
  id               String         @id @default(cuid())
