// ─── CRM 2.0: Labor contracts (owner → crew, for rollup jobs) ──────────────

model LaborContract {
  id                      String    @id @default(cuid())
  jobId                   String    @map("job_id")
  crewId                  String?   @map("crew_id") // null for ad-hoc/typed labor lines
  label                   String? // ad-hoc name when no crew selected
  contractAmount          Decimal   @map("contract_amount") @db.Decimal(12, 2)
  description             String?   @db.Text
  // Optional contract-detail fields surfaced on generated contract PDFs.
  paymentTerms            String?   @map("payment_terms") @db.Text
  startDate               DateTime? @map("start_date")
  estimatedCompletionDate DateTime? @map("estimated_completion_date")
  contractorLicense       String?   @map("contractor_license")
  contractorInsurance     String?   @map("contractor_insurance") @db.Text
  exclusions              String?   @db.Text
  notes                   String?   @db.Text
  retainagePercent        Decimal?  @map("retainage_percent") @db.Decimal(5, 2)
  retainageReleased       Boolean   @default(false) @map("retainage_released")
  retainageReleasedDate   DateTime? @map("retainage_released_date")
  delayDamagesPerDay      Decimal?  @map("delay_damages_per_day") @db.Decimal(12, 2)
  createdByUserId         String    @map("created_by_user_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  job                  Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crew                 Crew?               @relation(fields: [crewId], references: [id])
  createdBy            User                @relation(fields: [createdByUserId], references: [id])
  payments             LaborPayment[]
  changeOrders         LaborChangeOrder[]
  customerChangeOrders ChangeOrder[]
  budgetAllocations    BudgetAllocation[]
  generatedDocuments   GeneratedDocument[]
  tasks                LaborContractTask[]

  @@index([jobId])
  @@map("labor_contracts")
}

// Task / payment-schedule line items for a labor contract (interior renovation).
model LaborContractTask {
  id                 String    @id @default(cuid())
  laborContractId    String    @map("labor_contract_id")
  sortOrder          Int       @default(0) @map("sort_order")
  name               String
  room               String?
  description        String?   @db.Text
  paymentAmount      Decimal?  @map("payment_amount") @db.Decimal(12, 2)
  paymentPercent     Decimal?  @map("payment_percent") @db.Decimal(5, 2)
  inspectionRequired Boolean   @default(true) @map("inspection_required")
  inspectionStatus   String    @default("PENDING") @map("inspection_status") // PENDING | PASSED | FAILED | NA
  status             String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETE
  approvedBy         String?   @map("approved_by")
  approvedDate       DateTime? @map("approved_date")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  laborContract LaborContract @relation(fields: [laborContractId], references: [id], onDelete: Cascade)

  @@index([laborContractId])
  @@map("labor_contract_tasks")
}

model BudgetLine {
  id        String   @id @default(cuid())
  jobId     String   @map("job_id")
  category  String?
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  allocations       BudgetAllocation[]
  dailyLaborEntries DailyLaborEntry[]

  @@index([jobId])
  @@map("budget_lines")
}

model BudgetAllocation {
  id                String   @id @default(cuid())
  budgetLineId      String   @map("budget_line_id")
  expenseId         String?  @map("expense_id")
  laborContractId   String?  @map("labor_contract_id")
  // Field-labor stream: system-maintained 1:1 with a DailyLaborEntry whenever
  // the entry names a budget line (amount mirrors entry.totalCost). Never
  // hand-edited — the labor save service owns these rows.
  dailyLaborEntryId String?  @unique @map("daily_labor_entry_id")
  amount            Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  budgetLine      BudgetLine       @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  expense         JobExpense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  laborContract   LaborContract?   @relation(fields: [laborContractId], references: [id], onDelete: Cascade)
  dailyLaborEntry DailyLaborEntry? @relation(fields: [dailyLaborEntryId], references: [id], onDelete: Cascade)

  @@index([budgetLineId])
  @@index([expenseId])
  @@index([laborContractId])
  @@map("budget_allocations")
}

model LaborChangeOrder {
  id                  String   @id @default(cuid())
  laborContractId     String   @map("labor_contract_id")
  amount              Decimal  @db.Decimal(12, 2) // signed: positive add, negative credit (price adjustment)
  reason              String?  @db.Text
  changeDate          DateTime @default(now()) @map("change_date")
  // Optional addendum-detail fields surfaced on generated addendum PDFs.
  changeNumber        Int?     @map("change_number")
  scopeChange         String?  @map("scope_change") @db.Text
  addedScope          String?  @map("added_scope") @db.Text
  removedScope        String?  @map("removed_scope") @db.Text
  timeAdjustmentDays  Int?     @map("time_adjustment_days")
  updatedPaymentTerms String?  @map("updated_payment_terms") @db.Text
  paymentImpact       String?  @map("payment_impact") @db.Text
  retainageImpact     String?  @map("retainage_impact") @db.Text
  createdByUserId     String   @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")

  laborContract      LaborContract       @relation(fields: [laborContractId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdByUserId], references: [id])
  generatedDocuments GeneratedDocument[]
  changeOrder        ChangeOrder?

  @@index([laborContractId])
  @@map("labor_change_orders")
}

// Customer-facing change order. Emailed to the homeowner as a branded bill;
// they approve/reject via a no-login token link. On approval it bills the
// customer (contract/balance + invoice) and, when a crew cost + labor contract
// are set, creates a linked LaborChangeOrder so crew labor rollup stays correct.
model ChangeOrder {
  id                 String            @id @default(cuid())
  jobId              String            @map("job_id")
  laborContractId    String?           @map("labor_contract_id") // optional crew link
  number             Int // sequential per job
  title              String?
  description        String?           @db.Text // scope shown to the customer
  customerPrice      Decimal           @map("customer_price") @db.Decimal(12, 2) // what the owner is billed
  crewCost           Decimal?          @map("crew_cost") @db.Decimal(12, 2) // optional internal cost delta (signed)
  status             ChangeOrderStatus @default(DRAFT)
  // Customer approval (no-login token flow)
  token              String?           @unique
  tokenExpiresAt     DateTime?         @map("token_expires_at")
  sentAt             DateTime?         @map("sent_at")
  decidedAt          DateTime?         @map("decided_at")
  decisionName       String?           @map("decision_name") // typed name on approve/reject
  decisionIp         String?           @map("decision_ip")
  rejectionReason    String?           @map("rejection_reason") @db.Text
  // Links created on approval
  invoiceId          String?           @unique @map("invoice_id")
  laborChangeOrderId String?           @unique @map("labor_change_order_id")
  createdByUserId    String            @map("created_by_user_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  laborContract    LaborContract?    @relation(fields: [laborContractId], references: [id], onDelete: SetNull)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  laborChangeOrder LaborChangeOrder? @relation(fields: [laborChangeOrderId], references: [id], onDelete: SetNull)
  createdBy        User              @relation(fields: [createdByUserId], references: [id])
  // The SOV line approval added on a PROGRESS job (instead of `invoice`).
  sovLine          SovLine?

  @@index([jobId])
  @@index([status])
  @@map("change_orders")
}

model GeneratedDocument {
  id                 String                @id @default(cuid())
  jobId              String                @map("job_id")
  laborContractId    String?               @map("labor_contract_id")
  changeOrderId      String?               @map("change_order_id")
  documentType       GeneratedDocumentType @map("document_type")
  versionNumber      Int                   @map("version_number")
  fileName           String                @map("file_name")
  storageKey         String                @map("storage_key")
  fileId             String?               @map("file_id")
  generatedByUserId  String                @map("generated_by_user_id")
  generatedAt        DateTime              @default(now()) @map("generated_at")
  sourceDataSnapshot Json                  @map("source_data_snapshot")

  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  laborContract LaborContract?    @relation(fields: [laborContractId], references: [id], onDelete: SetNull)
  changeOrder   LaborChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  file          File?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  generatedBy   User              @relation(fields: [generatedByUserId], references: [id])

  @@index([jobId])
  @@index([laborContractId])
  @@index([changeOrderId])
  @@map("generated_documents")
}

model LaborPayment {
  id              String         @id @default(cuid())
  laborContractId String         @map("labor_contract_id")
  amount          Decimal        @db.Decimal(12, 2)
  paidDate        DateTime       @default(now()) @map("paid_date")
  method          PaymentMethod?
  reference       String?
  notes           String?        @db.Text
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  laborContract LaborContract @relation(fields: [laborContractId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdByUserId], references: [id])

  @@index([laborContractId])
  @@map("labor_payments")
}

// ─── CRM 2.0: Inspections ──────────────────────────────────────────────────

model Inspection {
  id            String           @id @default(cuid())
  jobId         String           @map("job_id")
  type          String
  scheduledDate DateTime?        @map("scheduled_date")
  result        InspectionResult @default(PENDING)
  notes         String?          @db.Text
  inspectorId   String?          @map("inspector_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inspector User? @relation(fields: [inspectorId], references: [id])

  @@index([jobId])
  @@map("inspections")
}

// ─── CRM 2.0: Payments ─────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// How a job is billed. LUMP_SUM invoices the balance (deposit, final, change
// orders). PROGRESS bills the work completed each period as a numbered payment
// application against a schedule of values, AIA G702/G703 style, with
// retainage withheld until release.
enum BillingMethod {
  LUMP_SUM
  PROGRESS
}

enum ChangeOrderStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  VOID
}

model PaymentSource {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_sources")
}

enum JobExpenseType {
  MATERIAL
  LABOR
  EQUIPMENT
  PERMIT_FEE
  SUBCONTRACTOR
  CHANGE_ORDER
  OTHER
}

/// Review state of a job charge.
///
/// Only APPROVED rows touch money. A PENDING charge is visible on the job and
/// in its own queue but contributes nothing to `contractAmount`,
/// `balanceDue`, the cost-plus rollup, job profit or the QBO export — so an
/// unreviewed charge can never change what a customer owes.
///
/// Defaults to APPROVED so that pre-existing rows (already in the ledger),
/// cc-allocator postings (already reviewed upstream) and payroll-generated
/// expenses (system-created) keep their current behaviour. Only the CRM's
/// manual-entry path decides otherwise.
enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobExpense {
  id               String         @id @default(cuid())
  jobId            String         @map("job_id")
  type             JobExpenseType @default(OTHER)
  vendor           String?
  description      String?        @db.Text
  amount           Decimal        @db.Decimal(12, 2)
  incurredDate     DateTime       @default(now()) @map("incurred_date")
  paidMethod       PaymentMethod? @map("paid_method")
  paidFrom         String?        @map("paid_from")
  billable         Boolean        @default(false)
  createdByUserId  String         @map("created_by_user_id")
  // Idempotency key for upstream integrations (cc-allocator sends txn.id).
  // Nullable so manually-created expenses are unaffected.
  externalId       String?        @unique @map("external_id")
  // Set when this expense was posted automatically by a payroll payment;
  // such expenses are excluded from cost-plus contract rollups (the labor
  // cost already flows through the field-labor stream until paid).
  payrollPaymentId String?        @map("payroll_payment_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  status           ExpenseStatus @default(APPROVED)
  approvedByUserId String?       @map("approved_by_user_id")
  approvedAt       DateTime?     @map("approved_at")
  /// Why it was rejected, or an optional note on approval. Rejected rows are
  /// kept rather than deleted — a charge filed against the wrong job is still
  /// a real cost someone needs to re-file.
  reviewNote       String?       @map("review_note") @db.Text

  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdByUserId], references: [id])
  approvedBy        User?              @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id])
  payrollPayment    PayrollPayment?    @relation(fields: [payrollPaymentId], references: [id], onDelete: Cascade)
  budgetAllocations BudgetAllocation[]

  @@index([jobId])
  @@index([type])
  @@index([payrollPaymentId])
  // Drives the review queue: "everything still pending, oldest first".
  @@index([status, incurredDate])
  @@map("job_expenses")
}

/// A human decision about a manual expense and the cc-allocator posting
/// that looks like the same charge. DUPLICATE deletes the manual row (the
/// delete reverses any contract increment); KEEP records that both are
/// real so the pair stops appearing. The manual row's identity is
/// snapshotted because it is gone after a DUPLICATE.
enum ExpenseReconcileDecision {
  DUPLICATE
  KEEP
}

/// A person's acknowledgement that a cc-allocator posting is deliberately
/// absent from the CRM (deleted here on purpose). Keyed by the posting's
/// externalId — the only identity both systems share — so the Cost
/// Reconciliation page can stop listing it as "missing here". Snapshots
/// the posting so the reason survives either side changing.
model AllocatorPostingAck {
  id              String   @id @default(cuid())
  externalId      String   @unique @map("external_id")
  source          String
  amount          Decimal  @db.Decimal(12, 2)
  payee           String?
  postedOn        DateTime @map("posted_on")
  crmJobId        String?  @map("crm_job_id")
  note            String?  @db.Text
  decidedByUserId String?  @map("decided_by_user_id")
  decidedAt       DateTime @default(now()) @map("decided_at")

  decidedBy User? @relation("AllocatorPostingAckedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@map("allocator_posting_acks")
}

model ExpenseReconciliation {
  id                 String                   @id @default(cuid())
  manualExpenseId    String                   @map("manual_expense_id")
  externalExpenseId  String                   @map("external_expense_id")
  decision           ExpenseReconcileDecision
  jobId              String                   @map("job_id")
  amount             Decimal                  @db.Decimal(12, 2)
  manualVendor       String?                  @map("manual_vendor")
  externalVendor     String?                  @map("external_vendor")
  manualIncurredOn   DateTime                 @map("manual_incurred_on")
  externalIncurredOn DateTime                 @map("external_incurred_on")
  note               String?                  @db.Text
  decidedByUserId    String?                  @map("decided_by_user_id")
  decidedAt          DateTime                 @default(now()) @map("decided_at")

  decidedBy User? @relation("ExpenseReconciledBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([manualExpenseId, externalExpenseId])
  @@index([jobId])
  @@map("expense_reconciliations")
}

model Invoice {
  id                String        @id @default(cuid())
  jobId             String        @map("job_id")
  invoiceNumber     String        @unique @map("invoice_number")
  issueDate         DateTime      @default(now()) @map("issue_date")
  dueDate           DateTime?     @map("due_date")
  amount            Decimal       @db.Decimal(12, 2)
  status            InvoiceStatus @default(DRAFT)
  paidAt            DateTime?     @map("paid_at")
  notes             String?       @db.Text
  // Payment application (PROGRESS jobs only). `amount` is the current payment
  // due — derived from the lines: completed-to-date × (1 − retainage) − prior
  // applications. Null on lump-sum invoices.
  applicationNumber Int?          @map("application_number")
  periodFrom        DateTime?     @map("period_from") @db.Date
  periodTo          DateTime?     @map("period_to") @db.Date
  retainagePercent  Decimal?      @map("retainage_percent") @db.Decimal(5, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder?
  payments    Payment[]
  lines       InvoiceLine[]
  tasks       Task[]

  @@unique([jobId, applicationNumber])
  @@index([jobId])
  @@index([status])
  @@map("invoices")
}

// Schedule of values (AIA G703) — the revenue-side breakdown of the contract
// that progress applications bill against. Deliberately separate from
// BudgetLine, which is the cost side. Σ scheduledValue should equal
// Job.contractAmount; the UI warns when it drifts (e.g. after a change order).
model SovLine {
  id             String   @id @default(cuid())
  jobId          String   @map("job_id")
  itemNo         Int      @map("item_no")
  description    String
  scheduledValue Decimal  @map("scheduled_value") @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  // Set when an approved change order added this line (PROGRESS jobs bill a
  // change order through the schedule of values, not as its own invoice).
  // The line's value follows the change order; deleting the change order
  // removes the line unless work has been billed on it.
  changeOrderId  String?  @unique @map("change_order_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changeOrder  ChangeOrder?  @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  invoiceLines InvoiceLine[]

  @@unique([jobId, itemNo])
  @@index([jobId])
  @@map("sov_lines")
}

// Work billed against one SOV line on one application. Everything cumulative
// (previous, to-date, %, balance to finish) is derived from earlier
// applications, so a line stores only this period's work.
model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  sovLineId     String   @map("sov_line_id")
  workCompleted Decimal  @map("work_completed") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sovLine SovLine @relation(fields: [sovLineId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, sovLineId])
  @@index([sovLineId])
  @@map("invoice_lines")
}

model Payment {
  id           String         @id @default(cuid())
  jobId        String         @map("job_id")
  paymentType  PaymentType    @map("payment_type")
  method       PaymentMethod?
  reference    String?
  amount       Decimal        @db.Decimal(12, 2)
  status       PaymentStatus  @default(PENDING)
  dueDate      DateTime?      @map("due_date")
  receivedDate DateTime?      @map("received_date")
  invoiceId    String?        @map("invoice_id")
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([status])
  @@index([invoiceId])
  @@map("payments")
}

// ─── CRM 2.0: Reviews + Referrals ──────────────────────────────────────────

model ReviewRequest {
  id          String       @id @default(cuid())
  jobId       String       @map("job_id")
  leadId      String       @map("lead_id")
