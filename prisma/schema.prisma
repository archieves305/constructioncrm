// ─── Core Tables ────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Field-module grants. Checked fresh from DB per request (never baked into
  // the JWT) so revocation is instant. ADMIN implicitly has all three.
  canViewSensitivePersonnel Boolean @default(false) @map("can_view_sensitive_personnel")
  canEditPayRates           Boolean @default(false) @map("can_edit_pay_rates")
  canViewPayrollReports     Boolean @default(false) @map("can_view_payroll_reports")

  // Enter and amend job costs. Office roles have this implicitly; the grant
  // is the escape hatch for a specific PM or crew lead who genuinely buys
  // materials, so nobody has to be promoted to MANAGER just to file a
  // receipt. A boolean rather than a new role deliberately: adding a role
  // means editing the CareyOS portal's appRoles, which is what orphaned
  // Frank's grant during the SSO cutover.
  canEnterJobCosts Boolean @default(false) @map("can_enter_job_costs")

  // Task mail is internal work assignment, not marketing, so it has no
  // unsubscribe link — but a user who mutes here stops receiving it. The
  // pressure valve exists so nobody resorts to a mail-client filter, which
  // would be invisible to us and would swallow genuinely urgent assignments.
  taskEmailsEnabled       Boolean @default(true) @map("task_emails_enabled")
  // Sub-channels under the master switch above. All three are moot when it
  // is off; each can be muted alone when it is on.
  escalationEmailsEnabled Boolean @default(true) @map("escalation_emails_enabled")
  reminderDigestEnabled   Boolean @default(true) @map("reminder_digest_enabled")
  nudgeEmailsEnabled      Boolean @default(true) @map("nudge_emails_enabled")

  role Role @relation(fields: [roleId], references: [id])

  assignedLeads            Lead[]                  @relation("AssignedUser")
  createdLeads             Lead[]                  @relation("CreatedByUser")
  assignmentsGiven         LeadAssignment[]        @relation("AssignedByUser")
  assignmentsOwned         LeadAssignment[]        @relation("AssignedToUser")
  stageChanges             LeadStageHistory[]      @relation("ChangedByUser")
  tasksAssigned            Task[]                  @relation("TaskAssignedUser")
  tasksCreated             Task[]                  @relation("TaskCreatedByUser")
  tasksCompleted           Task[]                  @relation("TaskCompletedByUser")
  tasksRemindSet           Task[]                  @relation("TaskRemindSetBy")
  taskEvents               TaskEvent[]             @relation("TaskEventActor")
  taskWatching             TaskWatcher[]           @relation("TaskWatcherUser")
  activityLogs             ActivityLog[]
  communications           Communication[]
  filesUploaded            File[]
  permitLookupRuns         PermitLookupRun[]
  managedJobs              Job[]                   @relation("ProjectManager")
  soldJobs                 Job[]                   @relation("SalesRep")
  jobStageChanges          JobStageHistory[]       @relation("JobChangedByUser")
  assignedPermits          JobPermit[]             @relation("PermitAssignedUser")
  inspections              Inspection[]
  passwordResetTokens      PasswordResetToken[]
  notifications            NotificationEvent[]
  expensesCreated          JobExpense[]
  expensesApproved         JobExpense[]            @relation("ExpenseApprovedBy")
  expenseReconciliations   ExpenseReconciliation[] @relation("ExpenseReconciledBy")
  allocatorPostingAcks     AllocatorPostingAck[]   @relation("AllocatorPostingAckedBy")
  jobTaskTemplatesDefault  JobTaskTemplate[]
  auditEvents              AuditEvent[]
  roofEstimatesCreated     RoofEstimate[]          @relation("RoofEstimateCreatedBy")
  estimatesCreated         Estimate[]              @relation("EstimateCreatedBy")
  roofrOrdersCreated       RoofrOrder[]            @relation("RoofrOrderCreatedBy")
  doorKnocksCreated        PropertyDoorKnock[]     @relation("DoorKnockKnockedBy")
  doorKnocksDeleted        PropertyDoorKnock[]     @relation("DoorKnockDeletedBy")
  doorKnockRoutesCreated   DoorKnockRoute[]        @relation("DoorKnockRouteCreatedBy")
  doorKnockRoutesAssigned  DoorKnockRoute[]        @relation("DoorKnockRouteAssignedTo")
  prospectsCreated         Prospect[]              @relation("ProspectCreatedBy")
  prospectsAssigned        Prospect[]              @relation("ProspectAssignedTo")
  laborContractsCreated    LaborContract[]
  laborPaymentsCreated     LaborPayment[]
  laborChangeOrdersCreated LaborChangeOrder[]
  changeOrdersCreated      ChangeOrder[]
  generatedDocuments       GeneratedDocument[]
  personnelRecord          Personnel?              @relation("PersonnelUser")
  personnelCreated         Personnel[]             @relation("PersonnelCreatedBy")
  personnelDocsUploaded    PersonnelDocument[]     @relation("PersonnelDocUploadedBy")
  jobPersonnelScopes       JobPersonnelScope[]     @relation("JobPersonnelScopeCreatedBy")
  dailyLogsManaged         DailyLog[]              @relation("DailyLogManager")
  dailyLogsSubmitted       DailyLog[]              @relation("DailyLogSubmittedBy")
  dailyLogsApproved        DailyLog[]              @relation("DailyLogApprovedBy")
  dailyLogsCreated         DailyLog[]              @relation("DailyLogCreatedBy")
  laborEntriesCreated      DailyLaborEntry[]       @relation("LaborEntryCreatedBy")
  payrollPaymentsMade      PayrollPayment[]        @relation("PayrollPaymentsMade")
  fieldAssignments         JobFieldAssignment[]    @relation("JobFieldAssignmentUser")
  fieldAssignmentsCreated  JobFieldAssignment[]    @relation("JobFieldAssignmentCreatedBy")
  fieldPhotosTaken         FieldPhoto[]            @relation("FieldPhotoTakenBy")
  fieldIssuesRaised        FieldIssue[]            @relation("FieldIssueRaisedBy")
  fieldIssuesAssigned      FieldIssue[]            @relation("FieldIssueAssignedTo")
  fieldIssuesResolved      FieldIssue[]            @relation("FieldIssueResolvedBy")
  workflowRoleDefaults     WorkflowRoleDefault[]   @relation("WorkflowRoleDefaultUser")
  workflowTeamSlots        JobWorkflowTeamMember[] @relation("WorkflowTeamUser")
  workflowsApplied         JobWorkflowInstance[]   @relation("WorkflowAppliedBy")
  permitsDetermined        JobWorkflowInstance[]   @relation("WorkflowPermitDeterminedBy")
  violationCasesManaged    CodeViolationCase[]     @relation("ViolationCaseManager")
  violationCasesCreated    CodeViolationCase[]     @relation("ViolationCaseCreatedBy")
  violationCasesClosed     CodeViolationCase[]     @relation("ViolationCaseClosedBy")
  violationItemsAssigned   CodeViolationItem[]     @relation("ViolationItemAssignedTo")
  violationHearingsAttending CodeViolationHearing[] @relation("ViolationHearingAttendee")
  violationInspectionsAttending CodeViolationInspection[] @relation("ViolationInspectionAttendee")
  violationEvents          CodeViolationEvent[]    @relation("ViolationEventActor")

  signatureHtml String? @map("signature_html") @db.Text
  signatureText String? @map("signature_text") @db.Text

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Lead Management ────────────────────────────────────────────────────────

model LeadSource {
  id          String      @id @default(cuid())
  name        String
  parentId    String?     @map("parent_id")
  channelType ChannelType @default(OTHER) @map("channel_type")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  parent   LeadSource?  @relation("SourceHierarchy", fields: [parentId], references: [id])
  children LeadSource[] @relation("SourceHierarchy")
  leads    Lead[]

  @@map("lead_sources")
}

model ServiceCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent            ServiceCategory?                  @relation("ServiceHierarchy", fields: [parentId], references: [id])
  children          ServiceCategory[]                 @relation("ServiceHierarchy")
  leadServices      LeadService[]
  workflowTemplates WorkflowTemplateServiceCategory[]

  @@map("service_categories")
}

model LeadStage {
  id         String   @id @default(cuid())
  name       String   @unique
  stageOrder Int      @map("stage_order")
  isClosed   Boolean  @default(false) @map("is_closed")
  isWon      Boolean  @default(false) @map("is_won")
  isLost     Boolean  @default(false) @map("is_lost")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  leads         Lead[]
  historyFrom   LeadStageHistory[] @relation("FromStage")
  historyTo     LeadStageHistory[] @relation("ToStage")
  followUpRules FollowUpRule[]     @relation("FollowUpRuleTargetStage")

  @@map("lead_stages")
}

model Lead {
  id                     String       @id @default(cuid())
  firstName              String       @map("first_name")
  lastName               String       @map("last_name")
  fullName               String       @map("full_name")
  companyName            String?      @map("company_name")
  primaryPhone           String       @map("primary_phone")
  secondaryPhone         String?      @map("secondary_phone")
  email                  String?
  propertyAddress1       String       @map("property_address_1")
  propertyAddress2       String?      @map("property_address_2")
  mailingAddress1        String?      @map("mailing_address_1")
  mailingAddress2        String?      @map("mailing_address_2")
  city                   String
  county                 String?
  state                  String       @default("FL")
  zipCode                String       @map("zip_code")
  propertyType           PropertyType @default(RESIDENTIAL) @map("property_type")
  sourceId               String?      @map("source_id")
  sourceDetail           String?      @map("source_detail")
  assignedUserId         String?      @map("assigned_user_id")
  currentStageId         String       @map("current_stage_id")
  estimatedJobValue      Decimal?     @map("estimated_job_value") @db.Decimal(12, 2)
  residentialCommercial  String?      @map("residential_commercial")
  insuranceClaim         Boolean      @default(false) @map("insurance_claim")
  financingNeeded        Boolean      @default(false) @map("financing_needed")
  urgent                 Boolean      @default(false)
  preferredContactMethod String?      @map("preferred_contact_method")
  notesSummary           String?      @map("notes_summary") @db.Text
  lastContactAt          DateTime?    @map("last_contact_at")
  nextFollowUpAt         DateTime?    @map("next_follow_up_at")
  isDuplicateFlag        Boolean      @default(false) @map("is_duplicate_flag")
  duplicateGroupId       String?      @map("duplicate_group_id")
  emailOptedOut          Boolean      @default(false) @map("email_opted_out")
  emailOptedOutAt        DateTime?    @map("email_opted_out_at")
  createdByUserId        String       @map("created_by_user_id")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  source       LeadSource? @relation(fields: [sourceId], references: [id])
  assignedUser User?       @relation("AssignedUser", fields: [assignedUserId], references: [id])
  currentStage LeadStage   @relation(fields: [currentStageId], references: [id])
  createdBy    User        @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  services       LeadService[]
  stageHistory   LeadStageHistory[]
  assignments    LeadAssignment[]
  tasks          Task[]
  activityLogs   ActivityLog[]
  communications Communication[]
  permits        Permit[]
  permitLookups  PermitLookupRun[]
  files          File[]
  jobs           Job[]
  reviewRequests ReviewRequest[]
  referrals      Referral[]
  notifications  NotificationEvent[]
  followUps      FollowUpExecution[]
  roofEstimates  RoofEstimate[]
  estimates      Estimate[]
  roofrOrders    RoofrOrder[]
  prospect       Prospect?
  violationCases CodeViolationCase[]

  @@index([primaryPhone])
  @@index([email])
  @@index([propertyAddress1, city, zipCode])
  @@index([assignedUserId])
  @@index([currentStageId])
  @@index([sourceId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
  @@map("leads")
}

model LeadService {
  id                String   @id @default(cuid())
  leadId            String   @map("lead_id")
  serviceCategoryId String   @map("service_category_id")
  createdAt         DateTime @default(now()) @map("created_at")

  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])

  @@unique([leadId, serviceCategoryId])
  @@map("lead_services")
}

model LeadStageHistory {
  id              String   @id @default(cuid())
  leadId          String   @map("lead_id")
  fromStageId     String?  @map("from_stage_id")
  toStageId       String   @map("to_stage_id")
  changedByUserId String   @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")
  reason          String?

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage LeadStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage   LeadStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedBy User       @relation("ChangedByUser", fields: [changedByUserId], references: [id])

  @@index([leadId])
  @@index([changedAt])
  @@map("lead_stage_history")
}

model LeadAssignment {
  id               String    @id @default(cuid())
  leadId           String    @map("lead_id")
  assignedUserId   String    @map("assigned_user_id")
  assignedByUserId String    @map("assigned_by_user_id")
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  unassignedAt     DateTime? @map("unassigned_at")
  reason           String?

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignedToUser", fields: [assignedUserId], references: [id])
  assignedBy User @relation("AssignedByUser", fields: [assignedByUserId], references: [id])

  @@index([leadId])
  @@map("lead_assignments")
}

// ─── Tasks ──────────────────────────────────────────────────────────────────

model Task {
  id              String     @id @default(cuid())
  leadId          String?    @map("lead_id")
  jobId           String?    @map("job_id")
  // Finer-grained anchors. A task on an invoice or daily log also carries the
  // parent jobId; one on an estimate or promoted prospect also carries the
  // leadId — so entity panels, emails and visibility keep working unchanged.
  estimateId      String?    @map("estimate_id")
  invoiceId       String?    @map("invoice_id")
  prospectId      String?    @map("prospect_id")
  dailyLogId      String?    @map("daily_log_id")
  // A task on a code-violation case (or one of its items) carries the case's
  // leadId but NOT a jobId — even when the case has a linked corrective job —
  // so case steps never appear in the construction job's queue or counts.
  violationCaseId String?    @map("violation_case_id")
  violationItemId String?    @map("violation_item_id")
  title           String
  description     String?    @db.Text
  assignedUserId  String?    @map("assigned_user_id")
  createdByUserId String     @map("created_by_user_id")
  dueAt           DateTime?  @map("due_at")
  priority        Priority   @default(MEDIUM)
  status          TaskStatus @default(PENDING)
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Who actually finished it — not always the assignee, so completedAt alone
  // cannot answer "who closed this?". Both are cleared on reopen.
  completedByUserId String?   @map("completed_by_user_id")
  // When the CURRENT assignment started, so "sitting with Frank for 9 days"
  // is answerable after a reassignment. Null while unassigned.
  assignedAt        DateTime? @map("assigned_at")
  // Required by the API whenever status becomes BLOCKED. A blocked task with
  // no stated reason is indistinguishable from one nobody has touched.
  blockedReason     String?   @map("blocked_reason") @db.Text

  // Provenance + idempotency key for automation: "estimate:SENT:<id>",
  // "invoice:SENT:<id>", "daily-log:RETURNED:<id>", "change-order:SENT:<id>".
  // Deliberately NOT unique — a re-sent estimate may spawn a fresh task after
  // the previous one closed; ensureAutoTask() checks for an OPEN row first.
  sourceKey         String?   @map("source_key")
  // Overdue-escalation ledger. Level = index of the highest threshold crossed
  // and mailed (0 = none). Reset to 0 whenever dueAt changes.
  escalationLevel   Int       @default(0) @map("escalation_level")
  lastEscalatedAt   DateTime? @map("last_escalated_at")
  // "Remind me on…". remindedAt is set by the morning cron on delivery so a
  // reminder fires exactly once; re-setting remindAt clears it.
  remindAt          DateTime? @map("remind_at")
  remindedAt        DateTime? @map("reminded_at")
  remindSetByUserId String?   @map("remind_set_by_user_id")

  // ── Workflow metadata ──────────────────────────────────────────────────
  // A workflow-generated task is an ORDINARY task with these columns filled
  // in; every list, email, board and field view keeps working unchanged.
  // `workflowTaskKey` is "<module>:<task>" ("roofing:permit_submit") and is
  // null on a manual task even when it sits inside a phase. The unique index
  // on (instance, key) is what makes Apply idempotent at the database.
  workflowInstanceId    String?                 @map("workflow_instance_id")
  workflowTaskKey       String?                 @map("workflow_task_key")
  workflowPhaseKey      String?                 @map("workflow_phase_key")
  workflowModuleKey     String?                 @map("workflow_module_key")
  workflowRole          WorkflowRole?           @map("workflow_role")
  workflowSortOrder     Int?                    @map("workflow_sort_order")
  workflowAnchor        WorkflowAnchor?         @map("workflow_anchor")
  dueOffsetBusinessDays Int?                    @map("due_offset_business_days")
  // A blocking gate holds its dependents until it is done; only ADMIN/MANAGER
  // may skip or override one.
  blocking              Boolean                 @default(false)
  // Null = "not active": the step exists but its predecessors are open, so it
  // stays out of every queue and count. Backfilled to created_at for all
  // pre-workflow tasks, so existing open counts did not move.
  activatedAt           DateTime?               @map("activated_at")
  // Set when someone edits the due date by hand; the engine then leaves it.
  dueLocked             Boolean                 @default(false) @map("due_locked")
  // CANCELLED + skipReason = "skipped" on a workflow step.
  skipReason            String?                 @map("skip_reason") @db.Text
  requiredEvidence      WorkflowEvidenceType?   @map("required_evidence")
  requiredEvidenceParam String?                 @map("required_evidence_param")
  // [{ key, label, done, doneAt?, doneByUserId? }]
  checklist             Json?
  // BLOCKED + inspectionResult FAIL = "failed inspection".
  inspectionResult      PermitInspectionResult? @map("inspection_result")
  inspectionRecordedAt  DateTime?               @map("inspection_recorded_at")

  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  job         Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  estimate    Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  prospect    Prospect?     @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  dailyLog    DailyLog?     @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  violationCase CodeViolationCase? @relation(fields: [violationCaseId], references: [id], onDelete: SetNull)
  violationItem CodeViolationItem? @relation(fields: [violationItemId], references: [id], onDelete: SetNull)
  assignedTo  User?         @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  createdBy   User          @relation("TaskCreatedByUser", fields: [createdByUserId], references: [id])
  completedBy User?         @relation("TaskCompletedByUser", fields: [completedByUserId], references: [id])
  remindSetBy User?         @relation("TaskRemindSetBy", fields: [remindSetByUserId], references: [id])
  fieldIssue  FieldIssue?
  events      TaskEvent[]
  watchers    TaskWatcher[]

  workflowInstance JobWorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  dependencies     TaskDependency[]     @relation("TaskDependencyTask")
  dependents       TaskDependency[]     @relation("TaskDependencyOn")
  files            File[]

  @@unique([workflowInstanceId, workflowTaskKey])
  @@index([workflowInstanceId, workflowPhaseKey])
  @@index([activatedAt])
  @@index([assignedUserId])
  @@index([dueAt])
  @@index([status])
  @@index([leadId])
  @@index([jobId])
  @@index([estimateId])
  @@index([invoiceId])
  @@index([prospectId])
  @@index([dailyLogId])
  @@index([violationCaseId])
  @@index([violationItemId])
  @@index([sourceKey])
  @@index([remindAt])
  @@map("tasks")
}

/// One chronological feed per task, covering BOTH user-written notes and
/// system-recorded changes. Kept as a single model rather than a notes table
/// plus an audit table so the timeline is one ordered read with no merge step.
///
/// Only NOTE rows carry `body` and are editable; every other type is an
/// immutable record of something that happened. EMAIL_SENT / EMAIL_FAILED
/// rows exist so "was the assignee actually told?" has an answer in-product
/// rather than only in the mail provider's dashboard.
model TaskEvent {
  id          String        @id @default(cuid())
  taskId      String        @map("task_id")
  actorUserId String?       @map("actor_user_id")
  type        TaskEventType
  body        String?       @db.Text
  fromValue   String?       @map("from_value")
  toValue     String?       @map("to_value")
  editedAt    DateTime?     @map("edited_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskEventActor", fields: [actorUserId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_events")
}

enum TaskEventType {
  NOTE
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_CHANGED
  BLOCKED
  UNBLOCKED
  WATCHER_ADDED
  WATCHER_REMOVED
  EMAIL_SENT
  EMAIL_FAILED
  NUDGED // toValue = assignee id, body = optional message
  ESCALATED // fromValue = old level, toValue = new level, body = recipients
  REMINDER_SET // toValue = ISO remindAt, or null when cleared
  REMINDER_SENT // toValue = recipient email
  AUTO_CLOSED // toValue = COMPLETED | CANCELLED, body = why
  // Workflow lifecycle (see docs/project-memory/features/workflows.md).
  ACTIVATED // toValue = why: "initial" | "dependencies" | "out_of_order" | "reconcile"
  SKIPPED // body = reason, toValue = actor role when a blocking gate was overridden
  DEPENDENCY_ADDED // toValue = predecessor task id
  DEPENDENCY_REMOVED // toValue = predecessor task id
  CHECKLIST_UPDATED // toValue = "done/total"
  EVIDENCE_ATTACHED // toValue = file id
  INSPECTION_RESULT // toValue = PASS | FAIL | CONDITIONAL, body = notes
  RECONCILED // body = what changed
}

/// Follow a task without owning it — a PM who wants the completion mail but
/// should not appear as the assignee. Assignee and creator are added
/// automatically, so this table is only ever the explicit extras.
model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

// ─── Activity Log ───────────────────────────────────────────────────────────

model ActivityLog {
