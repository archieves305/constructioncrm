  referredByLeadId String         @map("referred_by_lead_id")
  referredName     String         @map("referred_name")
  referredPhone    String?        @map("referred_phone")
  referredEmail    String?        @map("referred_email")
  status           ReferralStatus @default(NEW)
  convertedLeadId  String?        @map("converted_lead_id")
  commissionAmount Decimal?       @map("commission_amount") @db.Decimal(12, 2)
  commissionPaidAt DateTime?      @map("commission_paid_at")
  notes            String?        @db.Text
