generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  MANAGER
  SALES_REP
  OFFICE_STAFF
  MARKETING
  READ_ONLY
  CREW_LEAD
}

enum EmploymentType {
  W2
  CONTRACTOR_1099
  SUB_CREW
  TEMP
}

// How a worker is PAID, as distinct from EmploymentType (their tax
// classification). A 1099 contractor may be paid hourly or by the piece, and
// a W-2 employee may be on a fixed contract for a job.
enum PayType {
  CONTRACT
  HOURLY
  PIECEWORK
}

enum PersonnelStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum PersonnelDocumentType {
  W9
  GOVERNMENT_ID
  CERTIFICATION
  OTHER
}

enum DailyLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum FieldPhotoCategory {
  PROGRESS
  BEFORE
  AFTER
  ISSUE
  DAMAGE
  SAFETY
  MATERIAL_DELIVERY
  INSPECTION
  CHANGE_ORDER
  OTHER
}

enum FieldIssueType {
  OFFICE_FOLLOW_UP
  CO_REVIEW
  SAFETY
  MATERIAL_REQUEST
  INSPECTION_REMINDER
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  // Waiting on something external — materials, an inspection, a subcontractor.
  // Distinct from IN_PROGRESS so a stalled job stops reading as active work.
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  ASSIGNMENT_CHANGE
  TASK_CREATED
  TASK_COMPLETED
  CALL_LOGGED
  SMS_LOGGED
  EMAIL_LOGGED
  PERMIT_ADDED
  FILE_UPLOADED
  LEAD_CREATED
  LEAD_UPDATED
  JOB_CREATED
  JOB_STAGE_CHANGE
  PAYMENT_RECEIVED
  CREW_ASSIGNED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  REVIEW_REQUESTED
  REFERRAL_CREATED
}

enum PaymentType {
  DEPOSIT
  PROGRESS
  FINAL
  FINANCING_FUNDING
}

enum PaymentStatus {
  PENDING
  RECEIVED
  OVERDUE
  WAIVED
  REFUNDED
}

enum PaymentMethod {
  CHECK
  CARD
  ACH
  CASH
  FINANCING
  WIRE
  OTHER
}

enum JobType {
  FIXED_PRICE
  COST_PLUS
  OWNED_REHAB
}

enum MarginType {
  PERCENT
  FLAT
}

enum FinancingStatus {
  NOT_NEEDED
  PENDING_APPLICATION
  SUBMITTED
  APPROVED
  DENIED
  FUNDED
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  PARTIAL
  RESCHEDULED
}

enum ReviewStatus {
  PENDING
  SENT
  COMPLETED
  DECLINED
}

enum ReferralStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

enum EmailProcessingStatus {
  PENDING
  PROCESSING
  PARSED
  LEAD_CREATED
  DUPLICATE
  IGNORED
  FAILED
}

enum NotificationChannel {
  SMS
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CLICKED
}

enum TrackedActionType {
  OPEN_LEAD
  ACKNOWLEDGE
  START_CALL
  MARK_ATTEMPTED
  MARK_CONTACTED
}

enum CommunicationType {
  SMS
  CALL
  EMAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

enum ChannelType {
  PAID
  ORGANIC
  REFERRAL
  DIRECT
  SOCIAL
  OTHER
}

enum FileCategory {
  PHOTOS
  ESTIMATE
  PERMIT
  SIGNED_DOC
  INSURANCE
  INSPECTION
  LABOR_CONTRACT
  INTERIOR_RENOVATION_LABOR_CONTRACT
  CONTRACT_ADDENDUM
  OTHER
}

enum GeneratedDocumentType {
  LABOR_CONTRACT
  INTERIOR_RENOVATION_LABOR_CONTRACT
  CONTRACT_ADDENDUM
}

enum DoorKnockOutcome {
  NO_ANSWER
  SPOKE_WITH_OWNER
  SPOKE_WITH_OCCUPANT
  LEFT_DOOR_HANGER
  VACANT
  HOSTILE
  GATE_BLOCKED
  OTHER
}

enum DoorKnockRouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum DoorKnockStopStatus {
  PENDING
  VISITED
